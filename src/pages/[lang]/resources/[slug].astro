---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { guides, getGuide, guideCategories } from "../../../data/guides";
import { guideEn, guideHubEn } from "../../../data/guide-locales";
import { guideEnArticles } from "../../../data/guide-en-articles";
import { guideEnSupplements, guideEnFaqs } from "../../../data/guide-en-supplements";
import GuideCard from "../../../components/GuideCard.astro";

export function getStaticPaths() {
  return guides.flatMap((guide) => [
    { params: { lang: "zh", slug: guide.slug }, props: { slug: guide.slug, lang: "zh" } },
    { params: { lang: "en", slug: guide.slug }, props: { slug: guide.slug, lang: "en" } },
  ]);
}

const { slug, lang } = Astro.props as { slug: string; lang: "zh" | "en" };
const guide = getGuide(slug);
if (!guide) throw new Error(`Unknown guide: ${slug}`);
const en = lang === "en";
const localized = en ? guideEn[slug] : null;
const englishSections = en ? [...(guideEnArticles[slug] || []), ...(guideEnSupplements[slug] || [])] : null;
const title = localized?.title || guide.title;
const description = localized?.description || guide.description;
const category = guideCategories[guide.category];
const categoryLabel = en ? guideHubEn.categories[guide.category].label : category.label;
const canonicalPath = `/${lang}/resources/${guide.slug}/`;
const breadcrumbs = [
  { name: en ? "Resources" : "采购知识", url: `https://sheerherb.cn/${lang}/resources/` },
  { name: title, url: `https://sheerherb.cn${canonicalPath}` },
];
const relatedGuides = guide.relatedGuides.map((item) => getGuide(item)).filter(Boolean);
const inquiryHref = `/${lang}/contact/?interest=${encodeURIComponent(en ? title : guide.targetKeyword)}&source=${guide.slug}&type=guide`;
---
<BaseLayout
  lang={lang}
  title={en ? `${title} | Sheerherb Resources` : guide.seoTitle}
  description={description}
  canonicalPath={canonicalPath}
  breadcrumbs={breadcrumbs}
  pageType="article"
  article={{ headline: title, datePublished: guide.published, dateModified: guide.updated, section: categoryLabel }}
>
  <main>
    <section class="page-hero article-hero">
      <div class="container page-hero-grid">
        <div>
          <div class="eyebrow">SHEERHERB / {category.short}</div>
          <h1>{title}</h1>
          <p>{description}</p>
          <div class="article-meta">
            <span>{categoryLabel}</span>
            <span>{en ? "Updated" : "更新于"} <time datetime={guide.updated}>{guide.updated}</time></span>
            <span>{en ? `${guide.readingMinutes} min read` : `${guide.readingMinutes} 分钟阅读`}</span>
          </div>
          <div class="breadcrumbs"><a href={`/${lang}/`}>{en ? "Home" : "首页"}</a> / <a href={`/${lang}/resources/`}>{en ? "Resources" : "采购知识"}</a> / {title}</div>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="container content-layout">
        <article class="content-main article-body">
          <div class="article-takeaways">
            <strong>{en ? "Key Takeaways" : "本文要点"}</strong>
            <ul>{(localized?.summary || guide.summary).map((item) => <li>{item}</li>)}</ul>
          </div>

          {en ? (
            <>
              {(englishSections || []).map((section) => <section class="guide-article-section"><h2>{section.heading}</h2><p>{section.body}</p>{section.bullets && <ul class="check-list">{section.bullets.map((item) => <li>{item}</li>)}</ul>}{section.note && <div class="article-note"><strong>Purchasing note</strong><p>{section.note}</p></div>}</section>)}
              <div class="article-note"><strong>Before contacting a supplier</strong><p>Prepare the target ingredient identity, approved or draft specification, intended application, destination market, estimated quantity, sample needs and document requirements. Separate mandatory criteria from preferences and identify open questions so supplier responses can be reviewed on a comparable basis.</p></div>
              <section class="guide-article-section"><h2>Frequently Asked Questions</h2><div class="faq-list">{guideEnFaqs.map((item,index)=><details class="faq-item" open={index===0}><summary>{item.q}</summary><p>{item.a}</p></details>)}</div></section>
              <div class="article-note"><strong>Scope of this guide</strong><p>This guide supports general B2B purchasing preparation. Product identity, specifications, test results, document availability, regulatory suitability and commercial terms must be confirmed for the specific supplier, product, batch and project. It is not a substitute for supplier records, laboratory testing or qualified regulatory advice.</p></div>
            </>
          ) : (
            <>
              <nav class="article-toc" aria-label="文章目录">
                <strong>目录</strong>
                <ol>{guide.blocks.map((block, index) => block.type === "h2" ? <li><a href={`#section-${index}`}>{block.text.replace(/^\d+\.\s*/, "")}</a></li> : null)}</ol>
              </nav>
              {guide.blocks.map((block, index) => {
                if (block.type === "p") return <p>{block.text}</p>;
                if (block.type === "h2") return <h2 id={`section-${index}`}>{block.text}</h2>;
                if (block.type === "ul") return <ul class="check-list">{block.items.map((item) => <li>{item}</li>)}</ul>;
                if (block.type === "table") return <div class="table-wrap"><table class="data-table"><thead><tr>{block.head.map((cell) => <th scope="col">{cell}</th>)}</tr></thead><tbody>{block.rows.map((row) => <tr>{row.map((cell) => <td>{cell}</td>)}</tr>)}</tbody></table>{block.caption && <p class="table-caption">{block.caption}</p>}</div>;
                if (block.type === "note") return <div class="article-note"><strong>{block.title}</strong><p>{block.text}</p></div>;
                if (block.type === "links") return <div class="article-links"><strong>{block.title}</strong><div class="article-link-grid">{block.items.map((item) => <a href={item.href}><span>{item.label}</span>{item.note && <small>{item.note}</small>}</a>)}</div></div>;
                return null;
              })}
              <section class="article-faq"><h2>常见问题</h2><div class="faq-list">{guide.faq.map((item, index) => <details class="faq-item" open={index === 0}><summary>{item.q}</summary><p>{item.a}</p></details>)}</div></section>
            </>
          )}

          <div class="content-callout">
            <strong>{en ? "Need to confirm an ingredient or specification?" : "需要确认具体原料或规格？"}</strong>
            <p>{en ? "Share the target ingredient, application, quantity, destination market and required documents. We can first identify missing information before discussing sourcing options. This guide is for purchasing reference only and is not regulatory advice, a test conclusion or a quality guarantee." : "把目标成分、应用、数量、目的市场和需要的文件发给我们，先判断还缺哪些参数，再讨论供应选项。本文是采购沟通参考，不构成法规意见、检测结论或质量承诺。"}</p>
            <a class="button" href={inquiryHref}>{en ? "Submit an Inquiry" : "提交采购需求"} ↗</a>
          </div>

          <section class="article-related">
            <h2>{en ? "Continue Reading" : "继续阅读"}</h2>
            <div class="guide-grid guide-grid-two">{relatedGuides.map((item) => <GuideCard guide={item!} compact lang={lang} />)}</div>
          </section>
        </article>

        <aside class="content-aside">
          <div class="aside-card">
            <div class="eyebrow">{en ? "SOURCING INQUIRY" : "商务询盘"}</div>
            <h3>{en ? "Preparing an ingredient purchasing project?" : "正在准备这类原料的采购？"}</h3>
            <p>{en ? "Share your target ingredient, specification, application and volume so project-specific information and sourcing options can be reviewed." : "提交目标成分、规格、应用和数量，我们会按项目确认可获得的资料与供应选项。"}</p>
            <a class="button" href={inquiryHref}>{en ? "Submit an Inquiry" : "提交采购需求"} ↗</a>
          </div>
          <div class="aside-links">
            <a href={`/${lang}/resources/`}>{en ? "All Purchasing Guides" : "全部采购指南"} ↗</a>
            <a href={`/${lang}/products/`}>{en ? "Products & Ingredients" : "产品与原料"} ↗</a>
            <a href={`/${lang}/quality/`}>{en ? "Quality & Documents" : "质量与文件"} ↗</a>
            <a href={`/${lang}/custom-sourcing/`}>{en ? "Custom Sourcing" : "定制寻源"} ↗</a>
          </div>
        </aside>
      </div>
    </section>
  </main>
</BaseLayout>
