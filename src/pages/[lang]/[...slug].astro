---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { pages, pageSlugs } from "../../data/site";
import { getBrandCopy } from "../../data/brand";
export function getStaticPaths() {
  const paths = [];
  const langs = ["zh","en","de","ja","es","ru","it"];
  const featured = ["liposomal-vitamin-c","urolithin-a","shilajit-resin","berberine-hcl"];
  for (const lang of langs) {
    for (const slug of pageSlugs) paths.push({ params: { lang, slug }, props: { slug } });
    for (const slug of featured) paths.push({ params: { lang, slug: `products/${slug}` }, props: { slug: `products/${slug}` } });
    for (const slug of ["products/liposomal-ingredients","products/botanical-extracts","products/custom-sourcing"]) paths.push({ params: { lang, slug }, props: { slug } });
  }
  return paths;
}
const lang = Astro.params.lang as "zh" | "en" | "de" | "ja" | "es" | "ru" | "it";
const zh = lang === "zh";
const slug = Astro.props.slug as string;
const c = getBrandCopy(lang);
const isProductPath = slug.startsWith("products/");
const productSlug = isProductPath ? slug.split("/").pop() : "";
const featuredProduct = isProductPath ? c.products.find((item) => item[0] === productSlug) : null;
const copy = pages[slug as keyof typeof pages]?.[lang] || pages[slug as keyof typeof pages]?.zh;
const isAbout = slug === "about";
const isProducts = slug === "products";
const isTechnology = slug === "custom-sourcing";
const isQuality = slug === "quality";
const isIndustries = slug === "industries";
const title = featuredProduct ? featuredProduct[1] : isAbout ? c.aboutTitle : isTechnology ? c.technologyTitle : isProducts ? c.productsTitle : copy?.title || "Sheerherb";
const intro = featuredProduct ? featuredProduct[3] : isAbout ? c.aboutLead : isTechnology ? c.technologyLead : isProducts ? c.productsLead : copy?.intro || "";
const blocks = isAbout ? c.aboutBlocks : isTechnology ? c.technology : copy?.blocks || [];
const category = productSlug === "liposomal-ingredients" ? "liposomal" : productSlug === "botanical-extracts" ? "extracts" : productSlug === "custom-sourcing" ? "custom" : "";
const categoryCopy = {
  liposomal: { title: zh ? "脂质体相关原料" : "Liposomal-Related Ingredients", desc: zh ? "围绕磷脂、脂质材料及配套辅料，按目标体系、原料等级、来源与应用要求逐项沟通。" : "Discuss phospholipids, lipid materials and supporting ingredients against your system, grade, origin and application requirements.", tags: zh ? ["磷脂与脂质材料","配套辅料","体系适配","规格核对"] : ["Phospholipids","Lipid materials","System fit","Specification review"] },
  extracts: { title: zh ? "植物与功能性提取物" : "Botanical & Functional Extracts", desc: zh ? "从植物来源、使用部位、提取工艺、提取比例、标志性成分和检测方法等维度整理采购要求。" : "Define sourcing requirements by botanical origin, plant part, extraction process, extract ratio, marker compounds and test methods.", tags: zh ? ["植物来源","提取部位与工艺","标志性成分","检测方法"] : ["Botanical origin","Plant part & process","Marker compounds","Test methods"] },
  custom: { title: zh ? "定制化原料寻源" : "Custom Ingredient Sourcing", desc: zh ? "适用于指定成分、特殊规格、目标市场或现有供应链之外的原料开发需求。" : "For target ingredients, special specifications, destination markets or sourcing needs beyond existing supply options.", tags: zh ? ["指定成分","特殊规格","样品沟通","批量采购"] : ["Target ingredient","Special specs","Sample coordination","Bulk purchasing"] }
}[category];
const specRows = zh ? [["原料身份","中文名 / 英文名 / INCI / CAS（如适用）"],["来源与工艺","植物来源、使用部位、提取或加工工艺"],["关键指标","含量、提取比例、粒度、溶解性等目标指标"],["检测方法","HPLC、UV 或双方约定的检测方法"],["质量文件","COA、TDS、SDS 及可提供的批次资料"],["采购条件","样品量、预计采购量、包装、目的地与交期"]] : [["Ingredient identity","Name / INCI / CAS, where applicable"],["Origin & process","Source, plant part, extraction or processing method"],["Key parameters","Assay, ratio, particle size, solubility and target limits"],["Test methods","HPLC, UV or mutually agreed methods"],["Quality documents","COA, TDS, SDS and available batch records"],["Purchasing terms","Sample, volume, packaging, destination and lead time"]];
---
<BaseLayout lang={lang} title={title} description={intro}>
  <main class="inner-page">
    <section class="inner-hero"><div class="container"><div class="eyebrow">SHEERHERB / {isProductPath ? "INGREDIENT SOURCING" : isTechnology ? "TECHNOLOGY & SOURCING" : isQuality ? "QUALITY & DOCUMENTS" : isAbout ? "COMPANY" : "B2B INFORMATION"}</div><div class="inner-hero-grid"><div><h1>{categoryCopy?.title || title}</h1><p>{categoryCopy?.desc || intro}</p><div class="inner-actions"><a class="button" href={`/${lang}/contact/?product=${encodeURIComponent(categoryCopy?.title || title)}`}>{zh ? "提交该类原料需求" : "Send an Inquiry"} ↗</a><a class="inner-text-link" href={`/${lang}/products/`}>{zh ? "查看全部原料" : "All Ingredients"} →</a></div></div><div class="inner-hero-panel"><span>{zh ? "采购沟通要点" : "BUYER CHECKPOINTS"}</span><strong>{zh ? "先对规格，再谈供货" : "Specifications before supply"}</strong><ul><li>{zh ? "明确原料身份与目标指标" : "Confirm ingredient identity & parameters"}</li><li>{zh ? "核对检测方法与文件需求" : "Review test methods & documents"}</li><li>{zh ? "按项目确认样品与商务条件" : "Confirm samples & terms per project"}</li></ul></div></div><div class="breadcrumbs"><a href={`/${lang}/`}>{zh ? "首页" : "Home"}</a> / {categoryCopy?.title || title}</div></div></section>

    {isProducts ? <section class="section"><div class="container"><div class="buyer-section-head"><div><div class="eyebrow">01 / INGREDIENT CATEGORIES</div><h2>{zh ? "按原料方向快速查找" : "Browse by Ingredient Category"}</h2></div><p>{zh ? "先选择原料类别，再结合目标成分、规格、用途和采购数量提交需求。页面展示的是可沟通方向，具体供货以项目确认为准。" : "Choose a category, then share target ingredients, specifications, use and volume. Categories are sourcing directions; supply is confirmed per project."}</p></div><div class="category-cards"><a href={`/${lang}/products/botanical-extracts/`}><span>01 / BOTANICALS</span><h3>{zh ? "植物与功能性提取物" : "Botanical & Functional Extracts"}</h3><p>{zh ? "来源、提取工艺、含量指标与检测方法" : "Origin, extraction process, assay and testing"}</p><b>{zh ? "浏览类别" : "Explore"} ↗</b></a><a href={`/${lang}/products/liposomal-ingredients/`}><span>02 / LIPOSOMAL</span><h3>{zh ? "脂质体相关原料" : "Liposomal-Related Ingredients"}</h3><p>{zh ? "磷脂、脂质材料与配套原料需求" : "Phospholipids, lipid materials and supporting ingredients"}</p><b>{zh ? "浏览类别" : "Explore"} ↗</b></a><a href={`/${lang}/products/custom-sourcing/`}><span>03 / CUSTOM SOURCING</span><h3>{zh ? "指定原料与定制寻源" : "Custom Ingredient Sourcing"}</h3><p>{zh ? "指定成分、特殊规格与供应商寻源" : "Target ingredients, special specs and supplier sourcing"}</p><b>{zh ? "提交需求" : "Submit a brief"} ↗</b></a></div><div class="buyer-section-head product-head"><div><div class="eyebrow">02 / FEATURED PRODUCTS</div><h2>{zh ? "重点产品方向" : "Featured Products"}</h2></div><p>{zh ? "产品参数、检测方法、包装、起订量和供货周期请以当前批次文件及正式报价为准。" : "Confirm current specifications, methods, packaging, MOQ and lead time against batch documents and quotation."}</p></div><div class="featured-list">{c.products.map((item,i)=><a class="featured-row" href={`/${lang}/products/${item[0]}/`}><span class="featured-no">0{i+1}</span><div><h3>{item[1]}</h3><p>{item[3]}</p><small>{item[2]}</small></div><b>↗</b></a>)}</div></div></section>
    : featuredProduct ? <><section class="section"><div class="container product-detail-layout"><div><div class="product-detail-intro"><span class="eyebrow">PRODUCT BRIEF / {productSlug?.toUpperCase()}</span><h2>{zh ? "先确认产品规格，再进入报价与样品沟通" : "Confirm specifications before quotation and sampling"}</h2><p>{zh ? "为避免仅凭产品名称判断是否匹配，建议采购前提供目标含量、检测方法、应用场景和质量文件要求。我们将按项目核对可获得的供应资料。" : "To assess fit beyond the product name, share target assay, test method, application and documentation requirements. Available supplier information can then be reviewed per project."}</p></div><h3 class="spec-title">{zh ? "采购规格核对清单" : "Purchasing Specification Checklist"}</h3><div class="spec-table">{specRows.map((r,i)=><div><strong>{r[0]}</strong><span>{r[1]}</span></div>)}</div><p class="spec-note">{zh ? "说明：以上为采购沟通维度，并非该产品的已确认参数或质量承诺。具体指标请以对应批次 COA、产品规格书及双方书面确认结果为准。" : "Note: These are purchasing review points, not confirmed product specifications or quality claims. Refer to the relevant batch COA, specification sheet and written confirmation."}</p></div><aside class="product-inquiry-card"><span class="eyebrow">B2B INQUIRY</span><h3>{zh ? "获取该产品的规格与供货信息" : "Request Specifications & Supply Details"}</h3><p>{zh ? "提交目标规格、采购量和应用信息，便于针对性沟通。" : "Share target specifications, volume and application for a focused discussion."}</p><a class="button" href={`/${lang}/contact/?product=${encodeURIComponent(featuredProduct[1])}`}>{zh ? "询问该产品" : "Inquire About This Product"} ↗</a><div class="inquiry-mini"><b>{zh ? "建议一并提供" : "Helpful details"}</b><span>{zh ? "目标含量 / 检测方法 / 采购量 / 目的市场" : "Assay / Test method / Volume / Market"}</span></div><a class="back-link" href={`/${lang}/products/`}>← {zh ? "返回产品目录" : "Back to products"}</a></aside></div></section></>
    : categoryCopy ? <section class="section"><div class="container"><div class="buyer-section-head"><div><div class="eyebrow">INGREDIENT CATEGORY / {category.toUpperCase()}</div><h2>{zh ? "采购前需要核对的信息" : "What to Confirm Before Purchasing"}</h2></div><p>{categoryCopy.desc}</p></div><div class="category-tag-list">{categoryCopy.tags.map((tag,i)=><span><b>0{i+1}</b>{tag}</span>)}</div><div class="detail-columns"><div><h3>{zh ? "规格沟通建议" : "Specification Review"}</h3><p>{zh ? "请尽量提供产品名称、CAS/INCI（如适用）、目标含量或关键指标、检测方法、应用场景，以及可接受的替代规格。信息越完整，越容易判断供应可行性。" : "Share product name, CAS/INCI where applicable, target assay or key parameters, test method, application and acceptable alternatives. More detail helps assess sourcing feasibility."}</p></div><div><h3>{zh ? "文件与供货确认" : "Documents & Supply Review"}</h3><p>{zh ? "可按项目沟通 COA、TDS、SDS、样品、包装、预计采购量、交期和贸易条款。文件可提供范围、批次情况和供货条件均需逐项确认。" : "COA, TDS, SDS, samples, packaging, estimated volume, lead time and trade terms can be discussed per project. Availability and document scope require confirmation."}</p></div></div><a class="button" href={`/${lang}/contact/?product=${encodeURIComponent(categoryCopy.title)}`}>{zh ? "提交该类别采购需求" : "Submit Category Inquiry"} ↗</a></div></section>
    : <section class="section"><div class="container content-layout"><article class="content-main">{isQuality && <div class="quality-document-panel"><div class="eyebrow">QUALITY REVIEW / DOCUMENT CHECK</div><h2>{zh ? "采购前，把质量要求说清楚" : "Clarify Quality Requirements Before Purchasing"}</h2><p>{zh ? "不同原料、用途和目的市场对应的文件要求并不相同。建议在询价阶段明确所需文件、检测项目、限度和验收标准。" : "Document requirements vary by ingredient, use and destination market. Define required files, test items, limits and acceptance criteria at the inquiry stage."}</p><div class="document-chips">{["COA","TDS","SDS",zh?"批次信息":"Batch records",zh?"检测方法":"Test methods"].map(x=><span>{x}</span>)}</div></div>}{blocks.map((b,i)=><section class="content-block buyer-content-block"><span>0{i+1}</span><div><h2>{b[0]}</h2><p>{b[1]}</p></div></section>)}{isQuality && <div class="quality-footnote">{zh ? "重要提示：网站不代表所有产品均具备上述文件或认证。实际可提供资料、检测项目和法规适用性须以对应供应商及批次文件核验，并由采购方按目的市场要求确认。" : "Important: This does not imply every product has all listed documents or certifications. Verify available supplier and batch records and assess regulatory suitability for the destination market."}</div>}{isAbout && <div class="company-facts"><div><b>2010</b><span>{zh ? "国际站公开介绍的成立年份" : "Year stated on international site"}</span></div><div><b>R&D</b><span>{zh ? "活性物质载体系统研发方向" : "Active carrier system research"}</span></div><div><b>2</b><span>{zh ? "微球与纳米脂质体技术路径" : "Microsphere & nanoliposome paths"}</span></div></div>}</article><aside class="content-aside"><div class="aside-card buyer-aside"><div class="eyebrow">{zh ? "采购协作" : "B2B SOURCING"}</div><h3>{zh ? "正在评估原料供应商？" : "Evaluating Ingredient Suppliers?"}</h3><p>{zh ? "把目标原料、规格和采购计划发给我们，先进行需求梳理与供应可行性沟通。" : "Send your target ingredient, specifications and purchasing plan for an initial sourcing review."}</p><a class="button" href={`/${lang}/contact/`}>{zh ? "提交采购需求" : "Send an Inquiry"} ↗</a></div><div class="aside-links"><a href={`/${lang}/products/`}>{zh ? "产品与原料目录" : "Product Catalogue"} ↗</a><a href={`/${lang}/quality/`}>{zh ? "质量与文件说明" : "Quality & Documents"} ↗</a><a href={`/${lang}/custom-sourcing/`}>{zh ? "定制寻源流程" : "Custom Sourcing"} ↗</a></div></aside></div></section>}
    <section class="inner-bottom-cta"><div class="container"><div><span class="eyebrow">LET'S DISCUSS YOUR PROJECT</span><h2>{zh ? "有明确的原料目标？把采购要求发给我们。" : "Have a target ingredient? Share your purchasing brief."}</h2><p>{zh ? "可从产品名称、目标规格、应用、数量和目的市场开始。" : "Start with product name, target specifications, application, volume and destination market."}</p></div><a class="button button-light" href={`/${lang}/contact/`}>{zh ? "提交采购需求" : "Send an Inquiry"} ↗</a></div></section>
  </main>
</BaseLayout>
