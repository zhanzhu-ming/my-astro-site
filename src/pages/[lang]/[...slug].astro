---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { pages, pageSlugs } from "../../data/site";
import { getBrandCopy } from "../../data/brand";
export function getStaticPaths() {
  const paths = [];
  const langs = ["zh","en","de","ja","es","ru","it"];
  const featured = ["liposomal-vitamin-c","urolithin-a","shilajit-resin","berberine-hcl"];
  for (const lang of langs) {
    for (const slug of pageSlugs) paths.push({ params: { lang, slug }, props: { slug } });
    for (const slug of featured) paths.push({ params: { lang, slug: `products/${slug}` }, props: { slug: `products/${slug}` } });
    for (const slug of ["products/liposomal-ingredients","products/botanical-extracts","products/custom-sourcing"]) paths.push({ params: { lang, slug }, props: { slug } });
  }
  return paths;
}
const lang = Astro.params.lang as "zh" | "en" | "de" | "ja" | "es" | "ru" | "it";
const slug = Astro.props.slug as string;
const c = getBrandCopy(lang);
const productDetail = slug.startsWith("products/") && slug !== "products/";
const productSlug = productDetail ? slug.split("/").pop() : "";
const featuredProduct = productDetail ? c.products.find((item) => item[0] === productSlug) : null;
const legacyProduct = productDetail && !featuredProduct;
const copy = pages[slug as keyof typeof pages]?.[lang] || pages[slug as keyof typeof pages]?.zh;
const isAbout = slug === "about";
const isProducts = slug === "products";
const isTechnology = slug === "custom-sourcing";
const title = featuredProduct ? featuredProduct[1] : isAbout ? c.aboutTitle : isTechnology ? c.technologyTitle : isProducts ? c.productsTitle : copy?.title || "Sheerherb";
const intro = featuredProduct ? featuredProduct[3] : isAbout ? c.aboutLead : isTechnology ? c.technologyLead : isProducts ? c.productsLead : copy?.intro || "";
const blocks = isAbout ? c.aboutBlocks : isTechnology ? c.technology : copy?.blocks || [];
---
<BaseLayout lang={lang} title={title} description={intro}>
  <main>
    <section class="page-hero"><div class="container"><div class="eyebrow">SHEERHERB / {isTechnology ? "TECHNOLOGY" : isAbout ? "COMPANY" : "INFORMATION"}</div><h1>{title}</h1><p>{intro}</p><div class="breadcrumbs"><a href={`/${lang}/`}>{lang === "zh" ? "首页" : "Home"}</a> / {title}</div></div></section>
    <section class="section"><div class="container content-layout">
      <article class="content-main">
        {isProducts ? <>
          <div class="product-grid product-grid-four">
            {c.products.map((item, i) => <a class="product-card featured-product" href={`/${lang}/products/${item[0]}/`}>
              <div class="product-number">0{i+1}</div><div class="product-symbol">{["◉","✳","◌","◇"][i]}</div>
              <h3>{item[1]}</h3><p>{item[3]}</p><span class="product-tag">{item[2]}</span><span class="card-arrow">↗</span>
            </a>)}
          </div>
        </> : featuredProduct ? <>
          <div class="content-callout"><strong>{lang === "zh" ? "产品信息" : "Product Information"}</strong><p>{featuredProduct[3]}</p></div>
          <h2>{lang === "zh" ? "产品询盘" : "Product Inquiry"}</h2>
          <p>{lang === "zh" ? "如需了解产品规格、含量、检测方法、包装、起订量及供货情况，请通过询盘表单联系 Sheerherb，并注明目标市场与应用场景。" : "For specifications, content, test methods, packaging, MOQ and availability, contact Sheerherb through the inquiry form and include your target market and application."}</p>
          <a class="button" href={`/${lang}/contact/`}>{c.primary} ↗</a>
        </> : legacyProduct ? <>
          <div class="content-callout"><strong>{lang === "zh" ? "产品方向" : "Product Category"}</strong><p>{lang === "zh" ? "该分类页面保留为产品资料入口。具体产品和规格请以正式目录及询盘回复为准。" : "This category page is retained as a product-information entry point. Confirm individual products and specifications through the official catalogue and inquiry response."}</p></div>
          <h2>{lang === "zh" ? "联系产品团队" : "Contact the Product Team"}</h2><a class="button" href={`/${lang}/contact/`}>{c.primary} ↗</a>
        </> : blocks.map((b,i)=><section class="content-block"><span>0{i+1}</span><div><h2>{b[0]}</h2><p>{b[1]}</p></div></section>)}
      </article>
      <aside class="content-aside"><div class="aside-card"><div class="eyebrow">{lang === "zh" ? "商务询盘" : "BUSINESS INQUIRY"}</div><h3>{lang === "zh" ? "正在寻找产品或技术方案？" : "Looking for a product or technology solution?"}</h3><p>{lang === "zh" ? "告诉我们您的目标产品、应用和规格需求，进一步沟通相关信息。" : "Share your target product, application and specification requirements to discuss the relevant details."}</p><a class="button" href={`/${lang}/contact/`}>{c.primary} ↗</a></div><div class="aside-links"><a href={`/${lang}/products/`}>{lang === "zh" ? "全部产品" : "All Products"} ↗</a><a href={`/${lang}/custom-sourcing/`}>{lang === "zh" ? "创新技术" : "Technology"} ↗</a></div></aside>
    </div></section>
  </main>
</BaseLayout>
