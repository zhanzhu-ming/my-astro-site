---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { site } from "../../data/site";
import { getBrandCopy } from "../../data/brand";
export function getStaticPaths() {
  return [
    { params: { lang: 'en' } },
    { params: { lang: 'zh' } },
    { params: { lang: 'de' } }, // 德语 (德国)
    { params: { lang: 'ja' } }, // 日语 (日本)
    { params: { lang: 'es' } }, // 西班牙语 (西班牙)
    { params: { lang: 'ru' } }, // 俄语 (俄国)
    { params: { lang: 'it' } }, // 意大利语 (意大利)
  ];
}
const lang = Astro.params.lang as "zh" | "en" | "de" | "ja" | "es" | "ru" | "it";
const t = site[lang] || site.zh;
const copy = getBrandCopy(lang);
const en = lang !== "zh";
---
<BaseLayout lang={lang} title={en ? "Contact Sheerherb" : "联系我们"} description={copy.contactIntro}>
  <main>
    <section class="page-hero"><div class="container"><div class="eyebrow">SHEERHERB / CONTACT</div><h1>{lang === "zh" ? "联系我们" : "Contact Sheerherb"}</h1><p>{copy.contactIntro}</p><div class="breadcrumbs"><a href={`/${lang}/`}>{en ? "Home" : "首页"}</a> / {en ? "Contact" : "联系我们"}</div></div></section>
    <section class="section"><div class="container contact-intro-strip"><div><span class="eyebrow">B2B PURCHASING BRIEF</span><h2>{lang === "zh" ? "让我们更快理解您的采购项目" : "Help Us Understand Your Sourcing Project"}</h2><p>{lang === "zh" ? "提供越清晰的规格与采购信息，越有助于判断供应可行性并减少反复确认。暂时没有完整规格也可以先提交产品名称和目标用途。" : "Clear specifications and purchasing details help us assess feasibility. If you do not have a complete specification yet, start with the ingredient name and intended use."}</p></div><div class="contact-steps"><span>01　{lang === "zh" ? "需求梳理" : "Brief"}</span><span>02　{lang === "zh" ? "供应核对" : "Sourcing review"}</span><span>03　{lang === "zh" ? "样品与报价" : "Sample & quote"}</span></div></div><div class="container contact-layout">
      <div class="contact-copy"><div class="eyebrow">{en ? "LET'S TALK BUSINESS" : "商务合作沟通"}</div><h2>{en ? "Tell us about your product and application requirements." : "欢迎告诉我们您的产品方向与应用需求。"}</h2><p>{en ? "Please include the product name, target specification, application, estimated quantity and destination market. Do not submit confidential formulas or sensitive personal information." : "请提供产品名称、目标规格、应用场景、预计数量和目的市场。请勿提交配方机密或敏感个人信息。"}</p><div class="contact-detail"><small>{en ? "WHAT TO PREPARE" : "建议准备的信息"}</small><strong>{en ? "Ingredient · Specification · Application · Volume" : "原料名称 · 目标规格 · 应用场景 · 采购数量"}</strong></div><div class="contact-detail"><small>{en ? "BUSINESS EMAIL" : "商务邮箱"}</small><strong id="businessEmail">sales@sheerherb.com</strong></div><div class="contact-detail"><small>{en ? "PHONE / WHATSAPP" : "电话 / WhatsApp"}</small><strong>+86 19591570368</strong></div>
      <div class="contact-detail"><small>{en ? "OFFICE ADDRESS" : "办公地址"}</small><strong>{en ? "Room 1204, Vanke Huizhi Center, Yanta District, Xi'an, Shaanxi, China" : "中国陕西省西安市雁塔区万科汇智中心 1204 室"}</strong></div></div>
      <form class="inquiry-form" id="inquiryForm" data-lang={lang}>
        <div class="form-row"><label>{en ? "Name" : "姓名"} *<input name="name" required maxlength="120" autocomplete="name" /></label><label>{en ? "Company" : "公司名称"} *<input name="company" required maxlength="160" autocomplete="organization" /></label></div>
        <div class="form-row"><label>{en ? "Work email" : "工作邮箱"} *<input name="email" type="email" required maxlength="254" autocomplete="email" /></label><label>{en ? "Phone / WhatsApp" : "电话 / WhatsApp"}<input name="phone" maxlength="80" /></label></div>
        <div class="form-row"><label>{en ? "Product / Ingredient" : "关注产品 / 原料"} *<input name="interest" required maxlength="200" placeholder={en ? "e.g. liposomal vitamin C, Urolithin A..." : "例如：脂质体维生素 C、尿石素 A……"} /></label><label>{en ? "Estimated quantity" : "预计采购数量"}<input name="quantity" maxlength="120" placeholder={en ? "Sample / kg / MT / annual volume" : "样品 / kg / 吨 / 年需求量"} /></label></div>
        <label>{en ? "Destination market" : "目的市场"}<input name="market" maxlength="120" placeholder={en ? "Country / region" : "国家 / 地区"} /></label>
        <label>{en ? "Project details" : "项目需求"}<textarea name="message" rows="5" maxlength="4000" placeholder={en ? "Target specification, application, required documents, timeline..." : "目标规格、应用场景、所需文件、采购时间……"}></textarea></label>
        <label class="consent"><input type="checkbox" name="consent" required /> <span>{en ? "I agree that my information may be used to respond to this business inquiry." : "我同意所提供的信息用于回复本次业务咨询。"} </span></label>
        <button class="button form-submit" type="submit">{en ? "Submit Inquiry" : "提交询盘"} <span>↗</span></button>
        <p class="form-status" id="formStatus" role="status" aria-live="polite"></p>
        <p class="form-disclaimer">{en ? "Do not submit confidential formulas, trade secrets or sensitive personal data." : "请勿提交配方机密、商业秘密或敏感个人信息。"}</p>
      </form>
    </div></section>
  </main>
  
  <script>
const form = document.querySelector("#inquiryForm");
const status = document.querySelector("#formStatus");
const button = form?.querySelector("button[type='submit']");

// 优先读构建期的环境变量；如果部署环境没配置，就用下面这组兜底值（与 .env.example 一致）。
// anon / publishable key 本来就是公开给浏览器用的，写在前端不算泄密；
// 但绝不能把 service_role 或 secret key 放到这里。
const url = import.meta.env.PUBLIC_SUPABASE_URL || "https://juabwnoemnrhansayzpp.supabase.co";
const key = import.meta.env.PUBLIC_SUPABASE_ANON_KEY || "sb_publishable_iOGjI9dSo6_tSkEguN_QbQ_ts45FGww";

const pageLang = form?.dataset.lang || document.documentElement.lang || "zh";
const lang = pageLang.toLowerCase().split("-")[0] || "en";
const en = lang !== "zh";

form?.addEventListener("submit", async (event) => {
  event.preventDefault();
  status.textContent = "";

  if (!url || !key) {
    status.textContent = en
      ? "The inquiry form is not connected yet. Please contact us by email."
      : "表单尚未连接询盘数据库，请通过商务邮箱联系。";
    status.dataset.state = "error";
    return;
  }

  const data = new FormData(form);

  const payload = {
    name: String(data.get("name") || "").trim(),
    company: String(data.get("company") || "").trim(),
    email: String(data.get("email") || "").trim(),
    phone: String(data.get("phone") || "").trim() || null,
    interest: String(data.get("interest") || "").trim(),
    quantity: String(data.get("quantity") || "").trim() || null,
    market: String(data.get("market") || "").trim() || null,
    message: String(data.get("message") || "").trim() || null,
    language: lang,
    consent: data.get("consent") === "on"
  };

  button.disabled = true;
  button.textContent = en ? "Submitting…" : "正在提交…";

  try {
    // 旧版 anon key 是 JWT（eyJ 开头），需同时放进 Authorization；
    // 新版 sb_publishable_ 键只能走 apikey 头，否则网关会返回 Invalid JWT。
    const headers = {
      "Content-Type": "application/json",
      "apikey": key,
      "Prefer": "return=minimal"
    };
    if (key.startsWith("eyJ")) headers.Authorization = `Bearer ${key}`;

    const response = await fetch(`${url.replace(/\/$/, "")}/rest/v1/inquiries`, {
      method: "POST",
      headers,
      body: JSON.stringify(payload)
    });

    if (!response.ok) {
      const errorText = await response.text();
      throw new Error(errorText);
    }

    window.dataLayer = window.dataLayer || [];

    window.dataLayer.push({
      event: "inquiry_submit_success",
      inquiry_language: lang,
      inquiry_type: "B2B inquiry"
    });

    status.textContent = en
      ? "Thank you. Your inquiry has been received."
      : "提交成功，感谢您的询盘！我们会尽快与您联系。";

    status.dataset.state = "success";
    form.reset();

  } catch (err) {
    console.error("Inquiry submission failed", err);

    status.textContent = en
      ? "Submission failed. Please email us directly."
      : "提交失败，请稍后重试或通过商务邮箱联系。";

    status.dataset.state = "error";

  } finally {
    button.disabled = false;
    button.textContent = en ? "Submit Inquiry ↗" : "提交询盘 ↗";
  }
});

  </script>

</BaseLayout>
