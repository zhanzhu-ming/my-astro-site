
---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { site } from "../../data/site";

export function getStaticPaths() {
  return [
    { params: { lang: "zh" } },
    { params: { lang: "en" } },
  ];
}

const lang = Astro.params.lang as "zh" | "en";
const zh = lang === "zh";
const current = site[lang];

const content = zh
  ? {
      hero: "为全球采购商提供可靠的产品与供应链解决方案",
      subtitle: "从产品选型到定制生产，满足您的采购需求。",
      products: "热门产品",
      advantages: "为什么选择我们",
      services: "OEM / ODM 定制服务",
      contact: "告诉我们您的采购需求",
      contactText: "联系我们，获取产品资料和采购方案。",
      button: "立即询盘",
      items: ["产品品质", "灵活定制", "专业服务"],
      productsList: ["产品类别一", "产品类别二", "产品类别三"],
    }
  : {
      hero: "Reliable Products & Sourcing Solutions for Global Buyers",
      subtitle: "From product selection to customized manufacturing.",
      products: "Featured Products",
      advantages: "Why Choose Us",
      services: "OEM / ODM Services",
      contact: "Tell Us Your Sourcing Requirements",
      contactText: "Contact our team for product information and sourcing solutions.",
      button: "Send Inquiry",
      items: ["Product Quality", "Flexible Customization", "Professional Service"],
      productsList: ["Product Category One", "Product Category Two", "Product Category Three"],
    };
---

<BaseLayout
  lang={lang}
  title={current.name}
  description={content.subtitle}
>
  <section class="hero">
    <div class="hero-content">
      <span class="eyebrow">{current.tagline}</span>
      <h1>{content.hero}</h1>
      <p>{content.subtitle}</p>
      <a class="button" href={`/${lang}/contact/`}>
        {content.button}
      </a>
    </div>
  </section>

  <section class="section">
    <h2>{content.products}</h2>
    <div class="grid">
      {content.productsList.map((item, index) => (
        <a class="product-card" href={`/${lang}/products/`}>
          <div class="product-image">
            {String(index + 1).padStart(2, "0")}
          </div>
          <h3>{item}</h3>
          <span>{zh ? "了解更多 →" : "Learn More →"}</span>
        </a>
      ))}
    </div>
  </section>

  <section class="advantages">
    <h2>{content.advantages}</h2>
    <div class="grid">
      {content.items.map((item) => (
        <div class="advantage-card">
          <h3>{item}</h3>
          <p>{zh
            ? "根据实际企业优势填写具体介绍。"
            : "Add a description based on your actual business strengths."}
          </p>
        </div>
      ))}
    </div>
  </section>

  <section class="section service">
    <h2>{content.services}</h2>
    <p>
      {zh
        ? "提供产品规格、材质、品牌标识及包装方面的定制支持。"
        : "Customization options for specifications, materials, branding and packaging."}
    </p>
    <a class="button" href={`/${lang}/oem-odm/`}>
      {zh ? "了解定制服务" : "Explore Customization"}
    </a>
  </section>

  <section class="cta">
    <h2>{content.contact}</h2>
    <p>{content.contactText}</p>
    <a class="button" href={`/${lang}/contact/`}>
      {content.button}
    </a>
  </section>
</BaseLayout>

<style>
  .hero {
    min-height: 490px;
    padding: 100px 8%;
    display: flex;
    align-items: center;
    background: linear-gradient(120deg, #eff6ff, #f8fafc);
  }

  .hero-content {
    max-width: 850px;
  }

  .eyebrow {
    color: #2563eb;
    font-weight: 700;
  }

  h1 {
    font-size: clamp(32px, 5vw, 54px);
    line-height: 1.3;
    margin: 20px 0;
    color: #111827;
  }

  .hero p, .section p {
    font-size: 17px;
    line-height: 1.8;
    color: #64748b;
  }

  .button {
    display: inline-block;
    margin-top: 18px;
    padding: 14px 26px;
    background: #2563eb;
    color: white;
    border-radius: 5px;
    text-decoration: none;
    font-weight: 600;
  }

  .section, .advantages, .cta {
    padding: 75px 8%;
  }

  h2 {
    font-size: 30px;
    margin-bottom: 35px;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
  }

  .product-card, .advantage-card {
    padding: 25px;
    border: 1px solid #e5e7eb;
    border-radius: 8px;
    text-decoration: none;
    color: #111827;
  }

  .product-image {
    height: 160px;
    display: grid;
    place-items: center;
    background: #eff6ff;
    color: #2563eb;
    font-size: 40px;
    font-weight: 700;
  }

  .product-card span {
    color: #2563eb;
  }

  .advantages {
    background: #f8fafc;
  }

  .service {
    text-align: center;
  }

  .cta {
    text-align: center;
    background: #172554;
    color: white;
  }

  .cta p {
    color: #cbd5e1;
  }

  @media (max-width: 700px) {
    .grid {
      grid-template-columns: 1fr;
    }

    .hero {
      padding: 70px 6%;
    }
  }
</style>
