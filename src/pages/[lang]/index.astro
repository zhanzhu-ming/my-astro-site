---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { site, industries, processSteps, products as productCategories } from "../../data/site";
import { getBrandCopy } from "../../data/brand";
import { getSeo } from "../../data/seo";
import { featuredGuides } from "../../data/guides";

import GuideCard from "../../components/GuideCard.astro";
export function getStaticPaths() {
  return ["zh","en"].map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as "zh" | "en";
const t = site[lang] || site.zh;
const c = getBrandCopy(lang);
const seo = getSeo(lang, "home", c.heroTitle, c.heroLead);
---
<BaseLayout lang={lang} title={seo.title} description={seo.description}>
  <main>
    <section class="hero sheer-hero">
      <div class="hero-glow"></div>
      <div class="container hero-grid">
        <div class="hero-copy">
          <div class="eyebrow"><i></i>{c.heroEyebrow}</div>
          <h1>{c.heroTitle}</h1>
          <p class="hero-lead">{c.heroLead}</p>
          <div class="hero-actions"><a class="button" href={`/${lang}/contact/`}>{c.primary} <span>↗</span></a><a class="text-link" href={`/${lang}/products/`}>{c.secondary} <span>→</span></a></div>
          <div class="hero-meta"><span>01 / SOURCING</span><span>02 / SPECIFICATION</span><span>03 / PROCUREMENT</span></div>
        </div>

      </div>
      <div class="container hero-bottom"><span>{c.tagline}</span><span>{lang === "zh" ? "浏览产品与原料" : "EXPLORE INGREDIENTS"} ↓</span></div>
    </section>

    <section class="section">
      <div class="container">
        <div class="section-heading"><div><div class="eyebrow">01 / PRODUCTS</div><h2>{c.productsTitle}</h2></div><p>{c.productsLead}</p></div>
        <div class="product-grid product-grid-four">
          {c.products.map((item, i) => <a class="product-card featured-product" href={`/${lang}/products/${item[0]}/`}>
            <div class="product-number">0{i+1}</div>
            <h3>{item[1]}</h3><p>{item[3]}</p><span class="product-tag">{item[2]}</span><span class="card-arrow">↗</span>
          </a>)}
        </div>
      <div class="section-heading" style="margin-top:3rem"><div><div class="eyebrow">INGREDIENT CATEGORIES</div><h2>{lang === "zh" ? "按原料类别浏览" : "Browse Ingredient Categories"}</h2></div><p>{lang === "zh" ? "从原料类型进入，查看采购沟通重点与相关产品方向。" : "Explore sourcing categories and related product directions."}</p></div>
      <div class="product-grid">
        {(productCategories[lang] || productCategories.en).map((item, i) => <a class="product-card featured-product" href={`/${lang}/products/${item[0] === "liposomal" ? "liposomal-ingredients" : item[0] === "extracts" ? "botanical-extracts" : "custom-sourcing"}/`}>
          <div class="product-number">0{i+1}</div><h3>{item[1]}</h3><p>{item[2]}</p><span class="product-tag">{item[3]}</span><span class="card-arrow">↗</span>
        </a>)}
      </div>

      </div>
    </section>

    <section class="section section-soft">
      <div class="container">
        <div class="section-heading"><div><div class="eyebrow">PROCESS</div><h2>{t.sectionProcess}</h2></div><p>{t.sectionProcessLead}</p></div>
        <div class="process-grid">
          {processSteps[lang].map(([num, stepTitle, stepText]) => <article class="process-step"><span>{num}</span><h3>{stepTitle}</h3><p>{stepText}</p></article>)}
        </div>
        <p class="process-note">{lang === "zh" ? "流程用于说明采购沟通顺序，不构成对库存、交期或供货能力的保证。每一步的规格、文件与商务条件均需书面确认。" : "This process describes the sourcing communication sequence. It is not a guarantee of stock, lead time or supply capacity; specifications, documents and commercial terms require written confirmation."}</p>
      </div>
    </section>

    <section class="section section-dark">
      <div class="container">
        <div class="section-heading section-heading-dark"><div><div class="eyebrow eyebrow-light">02 / CORE OBJECTIVES</div><h2>{c.objectivesTitle}</h2></div><p>{c.objectivesLead}</p></div>
        <div class="objectives-grid">
          {c.objectives.map((item) => <article class="objective-card"><span>{item[0]}</span><h3>{item[1]}</h3><p>{item[2]}</p></article>)}
        </div>
      </div>
    </section>

    <section class="section section-soft">
      <div class="container">
        <div class="section-heading"><div><div class="eyebrow">03 / TECHNOLOGY</div><h2>{c.technologyTitle}</h2></div><p>{c.technologyLead}</p></div>
        <div class="technology-grid">
          {c.technology.map((item, i) => <article class="technology-card"><div class="technology-art"><span>0{i+1} / SHEERHERB</span></div><div><h3>{item[0]}</h3><p>{item[1]}</p><a href={i === 0 ? `/${lang}/products/botanical-extracts/` : `/${lang}/products/liposomal-ingredients/`}>{lang === "zh" ? "查看原料方向" : "Explore Ingredient Direction"} ↗</a></div></article>)}
        </div>
      </div>
    </section>

    <section class="section">
      <div class="container split-section about-preview">
        <div><div class="eyebrow">04 / ABOUT SHEERHERB</div><h2>{c.aboutTitle}</h2><p class="dark-lead">{c.aboutLead}</p><a class="button" href={`/${lang}/about/`}>{lang === "zh" ? "了解我们" : "About Sheerherb"} ↗</a></div>
        <div class="approach-list">{c.aboutBlocks.slice(0,3).map((item,i)=><div class="approach-item"><b>0{i+1}</b><div><h3>{item[0]}</h3><p>{item[1]}</p></div><span>↗</span></div>)}</div>
      </div>
    </section>

    <section class="section section-soft">
      <div class="container"><div class="section-heading"><div><div class="eyebrow">05 / APPLICATIONS</div><h2>{t.sectionIndustries}</h2></div><p>{c.heroLead}</p></div>
        <div class="industry-grid">{industries[lang].map((x,i)=><div class="industry-card"><span>0{i+1}</span><h3>{x[0]}</h3><small>{x[1]}</small></div>)}</div>
      </div>
    </section>
    <section class="section">
      <div class="container">
        <div class="section-heading"><div><div class="eyebrow">QUALITY FILES</div><h2>{lang === "zh" ? "质量文件不是一张证书" : "Quality Documentation Goes Beyond a Certificate"}</h2></div><p>{lang === "zh" ? "原料COA、TDS 和 SDS 回答不同问题。采购前先确认文件与批次、检测方法和目的市场是否对应。" : "COAs, TDSs and SDSs serve different purposes. Confirm batch relevance, test methods and destination-market requirements before purchasing."}</p></div>
        <div class="quality-strip">
          <a class="quality-strip-card" href={`/${lang}/quality/`}><span>COA</span><h3>{lang === "zh" ? "分析证书" : "Certificate of Analysis"}</h3><p>{lang === "zh" ? "核对批号、检测项目、方法、结果与判定。" : "Review batch number, test items, methods, results and acceptance."}</p><small>{lang === "zh" ? "批次符合性" : "Batch conformity"} ↗</small></a>
          <a class="quality-strip-card" href={`/${lang}/quality/`}><span>TDS</span><h3>{lang === "zh" ? "技术数据表" : "Technical Data Sheet"}</h3><p>{lang === "zh" ? "了解指标、外观、溶解性和应用信息。" : "Review specifications, appearance, solubility and application information."}</p><small>{lang === "zh" ? "规格匹配" : "Specification fit"} ↗</small></a>
          <a class="quality-strip-card" href={`/${lang}/quality/`}><span>SDS</span><h3>{lang === "zh" ? "安全数据表" : "Safety Data Sheet"}</h3><p>{lang === "zh" ? "确认储存、操作和运输安全信息。" : "Check safe handling, storage and transport information."}</p><small>{lang === "zh" ? "安全沟通" : "Safety review"} ↗</small></a>
        </div>
        <div class="quality-actions"><a class="button" href={`/${lang}/quality/`}>{lang === "zh" ? "了解质量与文件" : "Quality & Documents"}</a><a class="text-link" href={`/${lang}/resources/`}>{lang === "zh" ? "浏览采购指南 →" : "Browse Sourcing Guides →"}</a></div>
      </div>
    </section>
    <section class="section section-soft">
      <div class="container">
        <div class="section-heading"><div><div class="eyebrow">KNOWLEDGE</div><h2>{lang === "zh" ? "采购知识中心" : "Ingredient Sourcing Knowledge Hub"}</h2></div><p>{lang === "zh" ? "从原料规格、质量文件到供应商评估，把采购问题拆成可以确认的清单。" : "Turn ingredient specifications, quality documentation and supplier evaluation into clear purchasing checklists."}</p></div>
        <div class="guide-grid guide-grid-three">
          {featuredGuides.map((guide) => <GuideCard guide={guide} lang={lang} />)}
        </div>
        <div class="section-actions"><a class="button" href={`/${lang}/resources/`}>{lang === "zh" ? "浏览采购知识" : "Explore Procurement Resources"} ↗</a></div>
      </div>
    </section>
    <section class="section section-editorial">
      <div class="container editorial-feature">
        <div class="editorial-feature-copy">
          <div class="eyebrow">SHEERHERB / OUR APPROACH</div>
          <h2>{lang === "zh" ? "从原料本身出发，让采购沟通更清晰。" : "Start with the ingredient. Make every purchasing conversation clearer."}</h2>
          <p>{lang === "zh" ? "一项原料采购，往往同时涉及身份、规格、应用、检测方法、文件和商务条件。Sheerherb 将这些问题放进同一条沟通路径，先确认信息，再讨论供应选项。" : "An ingredient purchase often involves identity, specification, application, analytical methods, documents and commercial terms. Sheerherb brings these questions into one coordinated conversation: clarify the information first, then review potential supply options."}</p>
          <a class="text-link" href={`/${lang}/custom-sourcing/`}>{lang === "zh" ? "了解定制寻源方式" : "Explore Custom Sourcing"} ↗</a>
        </div>
      </div>
    </section>
    <section class="section section-soft">
      <div class="container">
        <div class="section-heading"><div><div class="eyebrow">06 / INGREDIENT PERSPECTIVES</div><h2>{lang === "zh" ? "从不同角度认识原料" : "A closer look at ingredients"}</h2></div><p>{lang === "zh" ? "从原料样品、应用场景到质量文件，建立清晰、可核对的采购认知。" : "Explore ingredients through samples, application contexts and quality records to build a clearer, verifiable purchasing brief."}</p></div>
        <div class="editorial-card-grid">
          <a class="editorial-card" href={`/${lang}/products/`}><div><span>01 / MATERIAL STUDY</span><h3>{lang === "zh" ? "原料与样品" : "Materials & Samples"}</h3><p>{lang === "zh" ? "明确原料身份、形态、规格和样品批次，是采购评估的起点。" : "Ingredient identity, physical form, specification and sample-batch details are the starting point for evaluation."}</p></div></a>
          <a class="editorial-card" href={`/${lang}/industries/`}><div><span>02 / APPLICATION CONTEXT</span><h3>{lang === "zh" ? "应用与配方" : "Applications & Formulation"}</h3><p>{lang === "zh" ? "应用场景会影响原料选择、检测重点、剂型和目标市场文件要求。" : "Application context shapes ingredient selection, testing priorities, dosage form and destination-market documentation."}</p></div></a>
          <a class="editorial-card" href={`/${lang}/quality/`}><div><span>03 / DOCUMENT REVIEW</span><h3>{lang === "zh" ? "质量文件与批次" : "Quality Records & Batches"}</h3><p>{lang === "zh" ? "把文件出具主体、产品身份、检测方法和批次对应关系逐项核对。" : "Review the issuing party, product identity, analytical method and batch relationship."}</p></div></a>
        </div>
      </div>
    </section>
    <section class="cta-band"><div class="container cta-inner"><div><div class="eyebrow eyebrow-light">LET'S WORK TOGETHER</div><h2>{c.ctaTitle}</h2><p>{c.ctaLead}</p></div><a class="button button-light" href={`/${lang}/contact/`}>{c.primary} ↗</a></div></section>
  </main>
</BaseLayout>
