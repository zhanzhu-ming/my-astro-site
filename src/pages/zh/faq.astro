---
import BaseLayout from "../../layouts/BaseLayout.astro";
const faqSchema = [];
const groups = [
{title:"脂质体原料采购 FAQ",items:[
["脂质体原料采购时，活性成分含量和包封率有什么区别？","活性成分含量表示单位产品中目标活性物的含量；包封率表示按约定方法测得被载体包封部分的比例。两者定义、计算口径和检测方法不同，不能互相替代。"],
["脂质体维生素 C 粉末与普通维生素 C 粉末有什么区别？","脂质体产品通常含磷脂等脂质载体结构，普通维生素 C 粉末不含该载体结构。吸收率、稳定性等差异需要具体产品数据支持，不能仅凭名称推断。"],
["脂质体粉末需要检测哪些指标？","通常需结合产品确认活性物含量、包封率、粒径/PDI、水分、外观、分散性、重金属、微生物及稳定性；并非每种产品都适用全部项目。"],
["包封率检测方法是否有统一标准？","不同活性物和载体体系可能采用不同分离与测定方法。采购方应要求供应商提供前处理、分离原理、计算公式及方法验证信息。"],
["脂质体产品的粒径和 PDI 越小越好吗？","不能脱离产品体系和应用判断。应确认测量仪器、样品稀释方式、测试条件、粒径分布及目标剂型的实际需求。"],
["脂质体粉末能用于固体饮料和压片糖果吗？","需通过配方测试确认复溶/分散性、加工温度、湿度、辅料相容性、感官和稳定性，并确认目的市场法规。"],
["采购脂质体原料需要哪些质量文件？","建议索取对应批次 COA、TDS、SDS，以及适用的重金属、微生物、残留溶剂和第三方检测报告。文件须对应具体产品和批次。"],
["脂质体原料是否支持 10 g–50 g 研发样品？","可提交 10 g–50 g 样品需求，具体可供性、费用、运费、批次和交期需按产品逐单确认。"],
["脂质体原料的 MOQ 和包装规格是多少？","不同产品、含量、包装和供应来源差异较大。MOQ、1 kg 铝箔袋或 25 kg 桶装等条件均需在询价时书面确认。"],
["脂质体原料可以开具 13% 增值税专用发票吗？","需由实际签约及开票主体根据交易性质、货物分类和适用税收政策确认。未取得书面确认前，不应默认承诺 13% 专票。"]]},
{title:"植物提取物采购 FAQ",items:[
["采购植物提取物时为什么必须提供拉丁学名？","中文俗名可能对应不同物种。拉丁学名、使用部位和来源信息有助于确认原料身份，降低错采风险。"],
["植物提取物的 10:1、20:1 是有效成分含量吗？","不是。提取比例描述原料投入与提取物产出的比例口径，不等于标志性成分含量；有效成分需通过适当检测方法确认。"],
["植物提取物 COA 应重点看哪些内容？","核对产品名称、批号、检测日期、外观、鉴别、标志性成分、检测方法、重金属、农残、微生物及判定限度。"],
["HPLC 和 UV 检测有什么区别？","HPLC 可分离并测定特定成分，UV 通常基于吸光度测定总量或特定响应。方法适用性取决于目标成分、基质和验证情况。"],
["植物提取物需要检测农药残留吗？","应结合植物来源、种植/加工情况、用途和目的市场要求确定农残项目及限度，并确认检测方法和报告批次。"],
["植物提取物需要检测重金属和微生物吗？","通常应根据产品用途、风险和法规要求设定重金属及微生物项目，具体限度应写入采购规格和验收标准。"],
["提取溶剂和残留溶剂信息重要吗？","重要。应了解提取溶剂、工艺步骤及是否需要残留溶剂检测，确保方法和限度符合产品规格与目标市场要求。"],
["植物提取物可以用于食品或保健食品吗？","不能仅凭供应商提供原料或 COA 判断。需按中国现行法规核实原料身份、允许用途、使用范围和产品类别。"],
["植物提取物是否支持小批量研发样品？","可提交目标样品量和用途，样品是否可提供、费用、运费及对应批次资料需逐项确认。"],
["采购植物提取物随货提供哪些文件？","建议要求批次 COA、TDS、SDS；按项目索取原料来源、提取工艺、第三方重金属/农残/微生物报告及适用证书。"]]},
{title:"功能性原料与商务采购 FAQ",items:[
["询价时应提供哪些信息？","建议提供原料中文/英文名、CAS 或 INCI（如适用）、目标规格、应用、目的市场、预计数量、包装偏好和所需质量文件。"],
["COA、TDS 和 SDS 分别有什么作用？","COA 是批次检测结果；TDS 说明技术规格和应用信息；SDS 说明安全、操作、储存及运输信息。三者不能相互替代。"],
["供应商提供的认证证书应该如何核验？","核对证书持有人、认证机构、编号、有效期、认证范围和生产地址，并确认其是否覆盖拟供产品及实际生产场所。"],
["是否可以先寄样再确定采购？","可提出样品申请。建议先明确样品批次、规格、检测计划和评价标准，再确认费用、发样条件及后续商业批次对应关系。"],
["样品检测合格是否代表大货一定合格？","不代表。样品结果仅对应被测样品；大货应按合同规格、批次 COA 和约定验收标准独立验收。"],
["MOQ 是否可以协商？","MOQ 受原料、规格、包装、供应来源和订单条件影响。请提供目标数量，由供应方确认可行起订量。"],
["是否支持 1 kg 铝箔袋和 25 kg 纸板桶？","可将其作为包装需求提出，但需确认产品适用包装、内衬材质、净重、标签和运输要求。"],
["是否支持免费样品？","样品政策因产品和项目而异。需确认样品本身费用、快递费用、数量和是否可提供对应批次文件。"],
["是否支持开具 13% 增值税专用发票？","须由实际开票主体根据商品税收分类、交易性质及现行税收政策确认，需在报价或合同中明确，不作统一税率承诺。"],
["你们是自有工厂还是供应链协作？","Sheerherb 中文站定位为植物提取物、脂质体原料及功能性成分 B2B 供应链协作。实际生产主体和生产能力按项目核实，不将合作方工厂表述为自有工厂。"]]}
];
---
<BaseLayout lang="zh" title="原料采购常见问题 FAQ｜脂质体、植物提取物与功能性成分" description="面向国内采购与研发人员的 FAQ，涵盖脂质体原料、植物提取物、COA/TDS/SDS、样品、MOQ、包装及增值税发票等常见问题。" canonicalPath="/zh/faq/" breadcrumbs={[{name:"采购 FAQ",url:"https://sheerherb.cn/zh/faq/"}]} alternateLanguages={["zh"]} faq={groups.flatMap((group) => group.items.map((item) => ({q:item[0],a:item[1]})))}>
<main><section class="page-hero"><div class="container"><div class="eyebrow">SHEERHERB / PROCUREMENT FAQ</div><h1>国内采购与研发常见问题</h1><p>围绕原料身份、规格、检测文件、样品和商务条件，提供可核对的采购沟通要点。</p><div class="breadcrumbs"><a href="/zh/">首页</a> / 采购 FAQ</div></div></section>
<section class="section"><div class="container">{groups.map((group,i)=><section class="content-block"><span>0{i+1}</span><div><h2>{group.title}</h2><div class="faq-list">{group.items.map((item)=><article class="faq-item"><h3>{item[0]}</h3><p>{item[1]}</p></article>)}</div></div></section>)}</div></section></main>
</BaseLayout>
