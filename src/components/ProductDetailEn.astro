---
const { product } = Astro.props as { product: readonly [string, string, string, string, string] };
const content: Record<string, { intro: string; identity: string; parameters: string[]; application: string[]; documents: string[]; questions: { q: string; a: string }[] }> = {
  "liposomal-vitamin-c": {
    intro: "A liposomal-related Vitamin C ingredient direction for B2B formulation and procurement discussions. The product name alone does not establish the carrier composition, active content, encapsulation performance or dosage-form suitability; review the current product specification and batch records before making a purchasing decision.",
    identity: "Confirm the Vitamin C form, active ingredient identity, phospholipid or carrier composition, dosage form and whether the offered material is a powder or another format. Ask the supplier to identify the manufacturing or trading entity shown on the product documents.",
    parameters: ["Vitamin C assay and analytical method", "Encapsulation efficiency, separation method and calculation basis, where applicable", "Particle-size distribution and PDI, where applicable", "Phospholipid source and carrier composition", "Moisture, appearance, dispersibility and stability data", "Heavy metals, microbiological limits and residual solvents where relevant"],
    application: ["Powdered dietary supplement concepts", "Capsule, tablet or sachet formulation development", "Functional food and beverage projects, subject to market review", "R&D screening and sample evaluation"],
    documents: ["Batch-specific COA with methods, results and acceptance limits", "TDS identifying composition, dosage form and key parameters", "SDS for handling, storage and transport", "Product specification and relevant test-method information", "Market- or customer-specific supporting records, where available"],
    questions: [{q:"Does the word liposomal confirm encapsulation performance?",a:"No. Request the test method, separation procedure, calculation basis and batch or sample data used to support any encapsulation-efficiency statement."},{q:"Can the ingredient be used in every supplement format?",a:"No universal suitability should be assumed. Review the dosage form, processing conditions, dispersibility, stability and destination-market requirements for the specific formulation."},{q:"Are samples and batch COAs always available?",a:"Availability must be checked for the relevant supplier, product and batch. Ask whether the proposed sample can be linked to the batch intended for quotation."}]
  },
  "urolithin-a": {
    intro: "A featured functional-ingredient direction for B2B sourcing discussions. Procurement should begin with the exact chemical identity, target grade, assay method, impurity profile and intended application rather than relying on a product name alone.",
    identity: "Confirm the ingredient name and identity reference, physical form, target grade, source and whether the product is a standalone ingredient or part of a premix. Request a current specification that identifies the test methods and acceptance limits.",
    parameters: ["Identity confirmation and assay method", "Assay or purity basis and calculation method", "Related substances or impurity profile, where applicable", "Residual solvents and elemental impurities where relevant", "Moisture, appearance and physical form", "Batch-specific acceptance limits and retest or expiry information"],
    application: ["Dietary supplement ingredient evaluation", "Capsule, tablet and powder formulation development", "R&D screening and analytical method review", "Brand or manufacturer sourcing qualification"],
    documents: ["Batch-specific COA", "TDS and approved product specification", "SDS and handling information", "Identity or analytical method references", "Additional records requested for the destination market or customer review"],
    questions: [{q:"What purity should be specified?",a:"The buyer should define a target and the method used to measure it. Confirm the assay basis, reference standard, impurity limits and acceptance criteria in the specification."},{q:"Can a typical assay value replace a batch COA?",a:"No. A typical or marketing value is not a batch result. Request a COA for the actual batch under consideration."},{q:"Is regulatory suitability the same in every market?",a:"No. The buyer must assess ingredient status, permitted use, labeling and finished-product requirements in each destination market with qualified regulatory support."}]
  },
  "shilajit-resin": {
    intro: "A botanical resin ingredient direction for B2B sourcing and product-development discussions. Identity, source, processing, marker compounds and contaminant controls should be reviewed together; appearance or a single marker value is not sufficient to establish quality.",
    identity: "Clarify the material's declared identity, source region if documented, raw-material and processing description, physical form and whether the offered material is a resin or another format. Ask how the supplier defines and verifies its identity.",
    parameters: ["Identity and source documentation", "Fulvic-acid or other marker assay, including method and calculation basis where claimed", "Heavy metals and other relevant elemental contaminants", "Microbiological limits and moisture", "Adulterant or authenticity testing where applicable", "Appearance, odor, solubility and batch-to-batch criteria"],
    application: ["Dietary supplement product development", "Resin-format product concepts", "Capsule or other formulation feasibility review", "R&D and supplier qualification"],
    documents: ["Batch-specific COA with contaminant results", "TDS describing form, handling and key parameters", "SDS and storage information", "Source or identity records where available", "Third-party test reports where specifically agreed"],
    questions: [{q:"Does a fulvic-acid percentage alone establish resin quality?",a:"No. Confirm the assay method and review identity, contaminants, authenticity and batch documentation together."},{q:"Can the source location be assumed from the product name?",a:"No. Request source information and supporting records from the actual supplier; do not infer origin from a trade name."},{q:"What should be checked before use in a finished product?",a:"Review identity, contaminants, test methods, intended use, dosage form and destination-market requirements. The buyer remains responsible for regulatory and formulation assessment."}]
  },
  "berberine-hcl": {
    intro: "A Berberine HCl ingredient direction for B2B procurement and formulation review. Confirm the exact salt identity, assay basis, analytical method, impurity controls and intended use before comparing quotations.",
    identity: "Confirm that the offered material is Berberine Hydrochloride, not a different berberine salt, extract or blend. Record the chemical identity reference, physical form, grade and supplier's specification revision.",
    parameters: ["Identity and assay method, commonly specified by the supplier's validated method", "Assay basis and acceptance limits", "Related substances or impurity profile where applicable", "Residual solvents and elemental contaminants where relevant", "Moisture, appearance and physical form", "Batch number, retest or expiry information and storage conditions"],
    application: ["Ingredient sourcing for supplement concepts, subject to market review", "Capsule, tablet and powder formulation development", "Analytical method and incoming-quality review", "R&D and supplier qualification"],
    documents: ["Batch-specific COA", "TDS and product specification", "SDS for handling and storage", "Analytical method or identity references", "Additional regulatory or customer records where available"],
    questions: [{q:"Is Berberine HCl interchangeable with a botanical berberine extract?",a:"No. A defined hydrochloride salt and a botanical extract are different material descriptions. Confirm identity and composition before comparing them."},{q:"Should assay values be compared without checking methods?",a:"No. Confirm the analytical method, reference standard, sample preparation and calculation basis before comparing results."},{q:"Does a product page establish permitted use?",a:"No. Confirm ingredient status, permitted use, labeling and finished-product requirements for the destination market with qualified advisers."}]
  }
};
const item = content[product[0]];
const name = product[1];
const inquiryHref = `/en/contact/?interest=${encodeURIComponent(name)}&source=${product[0]}&type=product`;
---
<div class="content-callout"><strong>Product overview</strong><p>{item.intro}</p><p class="reference-note">Product identity, specifications, batch records, document availability and commercial terms must be confirmed with the relevant supplier for each project.</p></div>
<section class="content-block"><span>01</span><div><h2>Ingredient identity & form</h2><p>{item.identity}</p></div></section>
<section class="content-block"><span>02</span><div><h2>Parameters to confirm</h2><p>Agree on the relevant parameters, analytical methods and acceptance limits in the approved specification. The list below is a purchasing checklist, not a statement that every parameter is available or applicable.</p><ul class="check-list">{item.parameters.map((x) => <li>{x}</li>)}</ul></div></section>
<section class="content-block"><span>03</span><div><h2>Analytical methods</h2><p>Ask the supplier to identify the method reference, sample preparation, reference standard, calculation basis and acceptance limits for each critical test. Results produced by different methods may not be directly comparable. If a parameter is essential to acceptance, define the method in the approved specification before ordering.</p></div></section>
<section class="content-block"><span>04</span><div><h2>Application directions</h2><p>Application fit depends on ingredient form, formulation, processing conditions, intended use and destination-market requirements. The following are discussion contexts, not efficacy or regulatory claims.</p><ul class="check-list">{item.application.map((x) => <li>{x}</li>)}</ul></div></section>
<section class="content-block"><span>05</span><div><h2>Quality documents</h2><p>Request documents that identify the actual supplier, product and relevant batch. Verify the issuing party, document revision, methods, results and scope before relying on them.</p><ul class="check-list">{item.documents.map((x) => <li>{x}</li>)}</ul></div></section>
<section class="content-block"><span>06</span><div><h2>Packaging & purchasing</h2><p>Before a sample or quotation is arranged, clarify the sample batch, quantity, pack format, packaging preference, estimated order volume, destination and requested timing. MOQ, stock, sample policy, price, lead time and shipping arrangements require current supplier confirmation and written terms.</p><ul class="check-list"><li>Sample availability and sample-batch identification</li><li>Commercial packaging and storage conditions</li><li>MOQ, price validity and quotation currency</li><li>Estimated lead time, shipping route and trade terms</li><li>Documents to accompany the commercial batch</li></ul></div></section>
<section class="content-block"><span>07</span><div><h2>Destination-market considerations</h2><p>Ingredient status, permitted use, labeling, import documentation and finished-product requirements differ by market and intended application. The buyer should verify applicable requirements with qualified regulatory support. A product listing or supplier statement is not a regulatory determination.</p></div></section>
<section class="content-block"><span>08</span><div><h2>Frequently asked purchasing questions</h2><div class="faq-list">{item.questions.map((q,index)=><details class="faq-item" open={index===0}><summary>{q.q}</summary><p>{q.a}</p></details>)}</div></div></section>
<section class="content-block"><span>09</span><div><h2>Related purchasing information</h2><ul class="related-guide-list"><li><a href="/en/quality/">Quality & Documents — COA, TDS and SDS review ↗</a></li><li><a href="/en/resources/">Ingredient Sourcing Knowledge Hub ↗</a></li><li><a href="/en/custom-sourcing/">Custom Sourcing & Procurement Coordination ↗</a></li></ul></div></section>
<div class="content-callout"><strong>Discuss {name} sourcing</strong><p>Share your target specification, intended application, estimated quantity, destination market and required documents. We can identify the information still needed before discussing possible supply options.</p><a class="button" href={inquiryHref}>Submit an Inquiry ↗</a></div>
