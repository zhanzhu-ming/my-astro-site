---
import BaseLayout from "../layouts/BaseLayout.astro";
import { products, industries, processSteps } from "../data/site";
const lang = "zh";
const productGroups = products.zh;
const useCases = industries.zh;
const steps = processSteps.zh;
---
<BaseLayout lang={lang} title="植物提取物与功能原料 B2B 采购合作" description="面向中国企业采购、研发与品牌客户，提供植物提取物、脂质体相关原料及功能性原料的供应对接、规格沟通、资料核对与采购协作。">
  <main class="cn-b2b-home">
    <section class="b2b-hero">
      <div class="hero-pattern" aria-hidden="true"><span></span><span></span><span></span></div>
      <div class="container b2b-hero-grid">
        <div class="hero-content">
          <div class="b2b-eyebrow"><i></i> SHEERHERB · B2B 原料采购与供应协作</div>
          <h1>植物提取物与功能原料<br /><em>让采购需求更快找到方向</em></h1>
          <p class="hero-description">面向食品、营养健康、化妆品及研发企业，围绕植物提取物、脂质体相关原料与功能性原料，开展产品寻源、规格沟通、供应商资料核对和采购协作。</p>
          <div class="hero-buttons">
            <a class="b2b-button" href="/zh/contact/">提交采购需求 <span>↗</span></a>
            <a class="b2b-link" href="#ingredient-categories">浏览原料类别 <span>↓</span></a>
          </div>
          <div class="hero-proof"><span>面向企业采购与研发</span><b></b><span>按项目确认规格与文件</span><b></b><span>支持样品需求沟通</span></div>
        </div>
        <div class="hero-panel" aria-label="采购需求信息示意">
          <div class="panel-top"><span>INGREDIENT SOURCING</span><span class="panel-dot">● ONLINE INQUIRY</span></div>
          <div class="panel-title">从需求开始，逐项确认</div>
          <p>把采购目标说清楚，减少来回沟通成本</p>
          <div class="panel-fields">
            <div><small>01 / 原料方向</small><strong>植物提取物 · 功能性原料</strong></div>
            <div><small>02 / 关键规格</small><strong>成分 / 含量 / 检测方法</strong></div>
            <div><small>03 / 采购计划</small><strong>样品需求 / 预计数量 / 交期</strong></div>
          </div>
          <a href="/zh/contact/" class="panel-action">填写您的采购需求 <span>↗</span></a>
          <div class="panel-orbit orbit-a"></div><div class="panel-orbit orbit-b"></div>
        </div>
      </div>
      <div class="container hero-bottomline"><span>BOTANICAL EXTRACTS</span><span>FUNCTIONAL INGREDIENTS</span><span>LIPOSOMAL-RELATED MATERIALS</span><span>CUSTOM SOURCING</span></div>
    </section>

    <section class="buyer-strip">
      <div class="container buyer-strip-inner">
        <div><strong>采购沟通更聚焦</strong><span>围绕目标成分与应用展开</span></div>
        <div><strong>规格信息先核对</strong><span>成分身份、指标与检测要求</span></div>
        <div><strong>资料与样品协调</strong><span>按项目确认可获得文件</span></div>
        <div><strong>订单过程有跟进</strong><span>商务条件与交付节点沟通</span></div>
      </div>
    </section>

    <section class="b2b-section" id="ingredient-categories">
      <div class="container">
        <div class="section-intro">
          <div><div class="b2b-kicker">01 / INGREDIENT CATEGORIES</div><h2>您正在寻找哪一类原料？</h2></div>
          <p>从具体采购目标出发，沟通原料身份、质量要求、应用场景和采购数量。以下类别用于说明业务方向，具体供应可行性以逐项确认结果为准。</p>
        </div>
        <div class="ingredient-grid">
          {productGroups.map((item, i) => <a class="ingredient-card" href={`/zh/products/${item[0] === "liposomal" ? "liposomal-ingredients" : item[0] === "extracts" ? "botanical-extracts" : "custom-sourcing"}/`}>
            <div class={`ingredient-art ingredient-art-${i+1}`}><span>{["植物","脂质","定制"][i]}</span><small>0{i+1} / SHEERHERB</small></div>
            <div class="ingredient-copy"><div class="ingredient-index">CATEGORY 0{i+1}</div><h3>{item[1]}</h3><p>{item[2]}</p><div class="ingredient-tags">{item[3].split(" / ").map(tag => <span>{tag}</span>)}</div><div class="ingredient-more">了解类别 <b>↗</b></div></div>
          </a>)}
          <a class="ingredient-card custom-card" href="/zh/custom-sourcing/">
            <div class="ingredient-art ingredient-art-4"><span>定向</span><small>PROJECT SOURCING</small></div>
            <div class="ingredient-copy"><div class="ingredient-index">CATEGORY 04</div><h3>指定原料与定制寻源</h3><p>已有明确的产品名称、CAS、INCI 或目标规格？可提交采购条件，沟通供应选项与资料要求。</p><div class="ingredient-tags"><span>指定成分</span><span>目标规格</span><span>批量采购</span></div><div class="ingredient-more">提交寻源需求 <b>↗</b></div></div>
          </a>
        </div>
        <div class="category-note"><span>TIP</span> 如果您已有规格书、COA 样本或目标产品链接，可在询盘中一并说明，便于更准确地评估需求。</div>
      </div>
    </section>

    <section class="b2b-section quality-section">
      <div class="container quality-layout">
        <div class="quality-heading"><div class="b2b-kicker">02 / SPECIFICATION & DOCUMENTS</div><h2>采购原料，先把关键指标说清楚</h2><p>不同应用和市场对原料的要求并不相同。建议在询盘阶段明确以下信息，便于双方高效核对。</p><a class="b2b-button" href="/zh/contact/">发送规格要求 <span>↗</span></a></div>
        <div class="quality-list">
          <div><span>01</span><section><h3>原料身份与来源</h3><p>植物名称、使用部位、原料来源及必要的身份识别信息。</p></section><b>↗</b></div>
          <div><span>02</span><section><h3>规格指标与检测方法</h3><p>提取比例、标志性成分、含量指标及对应检测方法。</p></section><b>↗</b></div>
          <div><span>03</span><section><h3>质量文件与批次信息</h3><p>根据项目需要沟通规格书、COA、检测报告及其他可获得文件。</p></section><b>↗</b></div>
          <div><span>04</span><section><h3>包装、数量与交付要求</h3><p>样品或批量需求、包装方式、预计采购量、交期和目的地。</p></section><b>↗</b></div>
        </div>
      </div>
    </section>

    <section class="b2b-section application-section">
      <div class="container">
        <div class="section-intro"><div><div class="b2b-kicker">03 / APPLICATIONS</div><h2>匹配您的产品应用场景</h2></div><p>不同终端用途对应不同的原料选择、指标和文件要求。请告诉我们您的产品方向与目标市场。</p></div>
        <div class="application-grid">
          {useCases.map((item, i) => <a href="/zh/industries/" class="application-card"><span>0{i+1}</span><div><h3>{item[0]}</h3><small>{item[1]}</small></div><b>↗</b></a>)}
        </div>
      </div>
    </section>

    <section class="b2b-section process-section">
      <div class="container">
        <div class="section-intro"><div><div class="b2b-kicker">04 / HOW WE WORK</div><h2>从需求沟通到订单交付</h2></div><p>每个项目按实际供应情况推进。规格、文件、价格、交期及贸易条款均在报价和下单前确认。</p></div>
        <div class="process-grid-b2b">
          {steps.map((step, i) => <article><div class="process-number">{step[0]}</div><div class="process-line"></div><h3>{step[1]}</h3><p>{step[2]}</p></article>)}
        </div>
      </div>
    </section>

    <section class="b2b-cta">
      <div class="container cta-content"><div class="b2b-kicker">LET'S DISCUSS YOUR SOURCING PROJECT</div><h2>正在寻找合适的植物提取物或功能原料？</h2><p>告诉我们目标成分、应用场景、规格要求和预计采购量。Sheerherb 将围绕您的需求开展进一步沟通。</p><div class="cta-actions"><a class="b2b-button b2b-button-light" href="/zh/contact/">立即提交采购需求 <span>↗</span></a><a href="mailto:sales@sheerherb.com" class="cta-email">sales@sheerherb.com</a></div></div>
      <div class="cta-decoration" aria-hidden="true"><span></span><span></span><span></span></div>
    </section>
    <div class="mobile-inquiry-bar"><span>有原料采购需求？</span><a href="/zh/contact/">立即询盘 ↗</a></div>
  </main>
</BaseLayout>

<style>
.cn-b2b-home{--b2b-navy:#102b3a;--b2b-teal:#087e80;--b2b-gold:#b89b65;--b2b-ink:#243941;--b2b-muted:#6d7d80;--b2b-line:#dce6e2;--b2b-soft:#f4f7f5;color:var(--b2b-ink)}
.cn-b2b-home .container{width:min(1180px,calc(100% - 48px));margin:0 auto}
.b2b-hero{position:relative;overflow:hidden;background:linear-gradient(115deg,#edf4ef 0%,#f8faf8 54%,#e5efea 100%);padding:84px 0 0}
.hero-pattern{position:absolute;right:-170px;top:-250px;width:720px;height:720px;border:1px solid #c9d9d0;border-radius:50%;box-shadow:0 0 0 50px #dce9e122,0 0 0 110px #dce9e122,0 0 0 170px #dce9e122}
.hero-pattern span{position:absolute;border:1px solid #b5ccc0;border-radius:50%;inset:90px}.hero-pattern span:nth-child(2){inset:180px;border-color:#c7b58c}.hero-pattern span:nth-child(3){inset:270px;border-color:#a6c2b4}
.b2b-hero-grid{position:relative;z-index:1;display:grid;grid-template-columns:1.08fr .92fr;gap:70px;align-items:center;padding-bottom:70px}
.b2b-eyebrow,.b2b-kicker{font-size:10px;letter-spacing:.18em;font-weight:700;color:var(--b2b-teal)}.b2b-eyebrow{display:flex;align-items:center;gap:11px}.b2b-eyebrow i{width:25px;height:1px;background:var(--b2b-gold)}
.hero-content h1{font-size:clamp(38px,4.5vw,58px);line-height:1.28;letter-spacing:-.045em;color:var(--b2b-navy);font-weight:650;margin:25px 0 18px}.hero-content h1 em{font-style:normal;color:var(--b2b-teal)}
.hero-description{font-size:15px;line-height:2;color:#607378;max-width:630px;margin:0}.hero-buttons{display:flex;align-items:center;gap:30px;margin-top:32px}.b2b-button{display:inline-flex;align-items:center;justify-content:center;gap:22px;background:var(--b2b-teal);border:1px solid var(--b2b-teal);padding:15px 23px;color:#fff;font-size:13px;font-weight:700;transition:.2s}.b2b-button:hover{background:#06696b;transform:translateY(-2px)}.b2b-link{font-size:13px;color:var(--b2b-navy);font-weight:700}.b2b-link span{color:var(--b2b-teal);margin-left:8px}.hero-proof{display:flex;align-items:center;gap:13px;flex-wrap:wrap;margin-top:43px;color:#71827f;font-size:10px}.hero-proof b{width:3px;height:3px;border-radius:50%;background:var(--b2b-gold)}
.hero-panel{position:relative;overflow:hidden;background:#fff;border:1px solid #dce7e1;padding:27px 30px 24px;box-shadow:0 25px 70px #1d414112;min-height:385px}.panel-top{display:flex;justify-content:space-between;gap:10px;color:#879994;font-size:8px;letter-spacing:.16em}.panel-dot{color:var(--b2b-teal)}.panel-title{font-size:25px;font-weight:650;color:var(--b2b-navy);margin-top:34px}.hero-panel>p{font-size:12px;color:#84928f;margin:5px 0 24px}.panel-fields{display:grid;gap:10px}.panel-fields>div{position:relative;z-index:1;border:1px solid #e3ebe7;background:#f8faf8;padding:12px 15px}.panel-fields small{display:block;font-size:9px;letter-spacing:.1em;color:#91a09a;margin-bottom:3px}.panel-fields strong{font-size:12px;color:#30484c;font-weight:600}.panel-action{display:flex;justify-content:space-between;position:relative;z-index:1;margin-top:17px;padding:13px 15px;background:#eff5f1;color:var(--b2b-teal);font-size:11px;font-weight:700}.panel-orbit{position:absolute;border:1px solid #d6e4dc;border-radius:50%;pointer-events:none}.orbit-a{width:190px;height:190px;right:-90px;top:85px}.orbit-b{width:120px;height:120px;right:-55px;top:120px;border-color:#c9b98e}
.hero-bottomline{position:relative;z-index:1;display:flex;justify-content:space-between;gap:16px;border-top:1px solid #d7e2dc;padding:17px 0;color:#84948f;font-size:9px;letter-spacing:.12em}
.buyer-strip{background:var(--b2b-navy);color:#fff}.buyer-strip-inner{display:grid;grid-template-columns:repeat(4,1fr);padding:22px 0}.buyer-strip-inner>div{padding:3px 24px;border-right:1px solid #ffffff28}.buyer-strip-inner>div:first-child{padding-left:0}.buyer-strip-inner>div:last-child{border:0}.buyer-strip strong,.buyer-strip span{display:block}.buyer-strip strong{font-size:13px;font-weight:600;color:#f1f5f2}.buyer-strip span{font-size:10px;color:#a9bfc0;margin-top:4px}
.b2b-section{padding:88px 0}.section-intro{display:grid;grid-template-columns:1fr .7fr;gap:55px;align-items:end;margin-bottom:35px}.section-intro h2,.quality-heading h2{font-size:34px;line-height:1.35;letter-spacing:-.035em;color:var(--b2b-navy);margin:13px 0 0}.section-intro>p{font-size:13px;line-height:1.95;color:var(--b2b-muted);margin:0}.ingredient-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px}.ingredient-card{display:grid;grid-template-columns:.72fr 1.28fr;min-height:260px;border:1px solid var(--b2b-line);background:#fff;transition:.25s}.ingredient-card:hover{border-color:#9bbcaf;transform:translateY(-3px);box-shadow:0 18px 40px #1b41410d}.ingredient-art{position:relative;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:12px;overflow:hidden;background:linear-gradient(145deg,#e5eee8,#f4f7f4);color:#43786c}.ingredient-art:before,.ingredient-art:after{content:"";position:absolute;border:1px solid #a9c4b6;border-radius:50%;width:155px;height:155px}.ingredient-art:after{width:105px;height:105px;border-color:#c3b58d}.ingredient-art span{position:relative;z-index:1;font-size:36px;font-weight:650;letter-spacing:.06em;color:#2e6257}.ingredient-art small{position:relative;z-index:1;font-size:8px;letter-spacing:.14em;color:#81988d}.ingredient-art-2{background:linear-gradient(145deg,#e6edf0,#f5f7f7);color:#4b7280}.ingredient-art-2:before{border-color:#a7c0c8;transform:scaleX(1.35)}.ingredient-art-2:after{border-color:#b8c3a3}.ingredient-art-2 span{color:#456c78}.ingredient-art-3{background:linear-gradient(145deg,#f0eee5,#f8f7f2)}.ingredient-art-3 span{color:#8a754d}.ingredient-art-3:before{border-color:#d4c8a7}.ingredient-art-3:after{border-color:#a9c1b2}.ingredient-art-4{background:linear-gradient(145deg,#e7ecef,#f6f8f7)}.ingredient-art-4 span{color:#526b78}.ingredient-copy{padding:23px 22px;display:flex;flex-direction:column}.ingredient-index{font-size:8px;letter-spacing:.16em;color:#91a09a}.ingredient-copy h3{font-size:18px;color:var(--b2b-navy);margin:10px 0 8px}.ingredient-copy p{font-size:11px;line-height:1.85;color:var(--b2b-muted);margin:0 0 14px}.ingredient-tags{display:flex;flex-wrap:wrap;gap:6px}.ingredient-tags span{font-size:9px;color:#678278;background:#eff5f1;padding:5px 8px}.ingredient-more{display:flex;justify-content:space-between;margin-top:auto;padding-top:17px;color:var(--b2b-teal);font-size:10px;font-weight:700}.category-note{margin-top:18px;padding:13px 16px;background:#f5f8f6;color:#778783;font-size:10px}.category-note span{font-weight:700;letter-spacing:.12em;color:var(--b2b-gold);margin-right:12px}
.quality-section{background:var(--b2b-soft)}.quality-layout{display:grid;grid-template-columns:.8fr 1.2fr;gap:90px;align-items:center}.quality-heading h2{font-size:36px}.quality-heading>p{font-size:13px;line-height:2;color:var(--b2b-muted);margin:18px 0 25px}.quality-list{border-top:1px solid #d8e3dd}.quality-list>div{display:grid;grid-template-columns:42px 1fr 20px;gap:17px;align-items:start;padding:20px 0;border-bottom:1px solid #d8e3dd}.quality-list>div>span{font-size:11px;color:var(--b2b-gold);padding-top:3px}.quality-list h3{font-size:15px;color:var(--b2b-navy);margin:0 0 5px}.quality-list p{font-size:11px;line-height:1.8;color:var(--b2b-muted);margin:0}.quality-list>div>b{font-size:12px;color:var(--b2b-teal)}
.application-section{background:#fff}.application-grid{display:grid;grid-template-columns:repeat(4,1fr);border-top:1px solid var(--b2b-line);border-bottom:1px solid var(--b2b-line)}.application-card{display:grid;grid-template-columns:30px 1fr 15px;gap:12px;align-items:center;padding:23px 18px;border-right:1px solid var(--b2b-line);transition:.2s}.application-card:last-child{border:0}.application-card:hover{background:#f6f9f7}.application-card>span{align-self:start;font-size:10px;color:var(--b2b-gold)}.application-card h3{font-size:13px;color:var(--b2b-navy);margin:0 0 5px}.application-card small{font-size:8px;color:#93a09b;letter-spacing:.07em}.application-card>b{color:var(--b2b-teal)}
.process-section{background:#f5f8f6}.process-grid-b2b{display:grid;grid-template-columns:repeat(4,1fr);gap:25px}.process-grid-b2b article{position:relative;border-top:1px solid #b9cbc1;padding-top:17px}.process-number{font-size:11px;letter-spacing:.14em;color:var(--b2b-teal)}.process-line{position:absolute;right:0;top:-3px;width:5px;height:5px;background:var(--b2b-gold);border-radius:50%}.process-grid-b2b h3{font-size:16px;color:var(--b2b-navy);margin:19px 0 7px}.process-grid-b2b p{font-size:11px;line-height:1.85;color:var(--b2b-muted);margin:0}
.b2b-cta{position:relative;overflow:hidden;background:linear-gradient(110deg,#17414a,#102b3a);padding:66px 0;color:#fff}.cta-content{position:relative;z-index:1}.b2b-cta .b2b-kicker{color:#d5c49f}.b2b-cta h2{font-size:clamp(25px,3.2vw,38px);line-height:1.4;font-weight:600;margin:14px 0 9px}.b2b-cta p{font-size:13px;line-height:1.9;color:#c0d0cf;max-width:680px}.cta-actions{display:flex;align-items:center;gap:25px;margin-top:25px}.b2b-button-light{background:#fff;color:var(--b2b-navy);border-color:#fff}.b2b-button-light:hover{background:#e9f1ed;color:var(--b2b-navy)}.cta-email{font-size:12px;color:#d5e0dc}.cta-decoration{position:absolute;width:500px;height:500px;right:-100px;top:-230px;border:1px solid #ffffff20;border-radius:50%;box-shadow:0 0 0 55px #ffffff08,0 0 0 115px #ffffff08}.cta-decoration span{position:absolute;inset:90px;border:1px solid #ffffff20;border-radius:50%}.cta-decoration span:nth-child(2){inset:180px}.cta-decoration span:nth-child(3){inset:270px}
