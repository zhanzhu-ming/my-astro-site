---
import "../styles/global.css";
import { site } from "../data/site";
import { getBrandCopy } from "../data/brand";
const {
  lang = "zh",
  title,
  description,
  canonicalPath,
  noindex = false,
  breadcrumbs = [],
  pageType = "website",
  productName = "",
} = Astro.props;
const t = site[lang] || site.zh;
const copy = getBrandCopy(lang);
const languageLabels = [["zh","中文"],["en","English"],["de","Deutsch"],["ja","日本語"],["es","Español"],["ru","Русский"],["it","Italiano"]];
const pathRaw = Astro.url.pathname.replace(/^\/(zh|en|de|ja|es|ru|it)(?=\/|$)/, "") || "/";
const path = pathRaw.endsWith("/") ? pathRaw : `${pathRaw}/`;
const languageName = languageLabels.find(([code]) => code === lang)?.[1] || lang.toUpperCase();
const htmlLang = ({ zh: "zh-CN", en: "en", de: "de", ja: "ja", es: "es", ru: "ru", it: "it" })[lang] || "zh-CN";
const canonicalUrlPath = canonicalPath || (Astro.url.pathname.endsWith("/") ? Astro.url.pathname : `${Astro.url.pathname}/`);
const canonical = `https://sheerherb.cn${canonicalUrlPath}`;
const pageTitle = title ? `${title} | Sheerherb` : "Sheerherb";
const desc = description || copy.heroLead;
const breadcrumbItems = breadcrumbs.length ? breadcrumbs : (Astro.url.pathname.replace(/\/$/, "").split("/").filter(Boolean).slice(1).map((part) => ({ name: part, url: `https://sheerherb.cn/${lang}/${part}/` })));
const structuredData = [
  {
    "@type": "Organization",
    "@id": "https://sheerherb.cn/#organization",
    name: "Sheerherb",
    url: "https://sheerherb.cn/zh/",
    email: "sales@sheerherb.com",
  },
  {
    "@type": "WebSite",
    "@id": "https://sheerherb.cn/#website",
    url: "https://sheerherb.cn/zh/",
    name: "Sheerherb",
    publisher: { "@id": "https://sheerherb.cn/#organization" },
    inLanguage: htmlLang,
  },
  ...(breadcrumbItems.length ? [{
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: lang === "zh" ? "首页" : "Home", item: `https://sheerherb.cn/${lang}/` },
      ...breadcrumbItems.map((item, index) => ({ "@type": "ListItem", position: index + 2, name: item.name, item: item.url })),
    ],
  }] : []),
];
const jsonLd = JSON.stringify({ "@context": "https://schema.org", "@graph": structuredData }).replace(/</g, "\\u003c");
---
<!doctype html>
<html lang={htmlLang}>
<head>
  <!-- Google Tag Manager -->
  <script>
    (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
    new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
    j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
    'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
    })(window,document,'script','dataLayer','GTM-ND9Z73J6');
  </script>
  <!-- End Google Tag Manager -->
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content={desc} />
  <meta name="theme-color" content="#102b3a" />
  <meta name="robots" content={noindex ? "noindex,follow" : "index,follow,max-image-preview:large"} />
  <meta name="twitter:card" content="summary" />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Sheerherb" />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={desc} />
  <meta property="og:url" content={canonical} />
  <meta property="og:locale" content={htmlLang} />
  <title>{pageTitle}</title>
  <link rel="canonical" href={canonical} />
  {languageLabels.map(([code]) => <link rel="alternate" hreflang={code === "zh" ? "zh-CN" : code} href={`https://sheerherb.cn/${code}${path === "/" ? "/" : path}`} />)}
  <link rel="alternate" hreflang="x-default" href={`https://sheerherb.cn/zh${path === "/" ? "/" : path}`} />
  <script type="application/ld+json" set:html={jsonLd}></script>
</head>
<body data-page-type={pageType} data-product-name={productName}>
  <!-- Google Tag Manager (noscript) -->
  <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-ND9Z73J6"
  height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
  <!-- End Google Tag Manager (noscript) -->
  <div class="topline"><div class="container top-inner"><span>{t.tagline}</span><a href={`/${lang}/contact/`}>{lang === "zh" ? "商务联系" : "Business Contact"} ↗</a></div></div>
  <header class="site-header">
    <div class="container nav-wrap">
      <a class="brand" href={`/${lang}/`} aria-label="Sheerherb">
        <span class="brand-mark">S<span>.</span></span>
        <span><strong>Sheerherb</strong><small>{t.tagline}</small></span>
      </a>
      <nav class="desktop-nav" aria-label="Main navigation">
        {t.nav.map(([slug, label]) => <a href={`/${lang}/${slug}/`}>{label}</a>)}
      </nav>
      <div class="nav-actions">
        <details class="language-menu">
          <summary aria-label="Select language">{languageName} ▾</summary>
          <ul class="language-options">
            {languageLabels.map(([code, label]) => <li><a href={`/${code}${path}`} aria-current={code === lang ? "page" : undefined}>{label}{code === lang ? " ✓" : ""}</a></li>)}
          </ul>
        </details>
        <a class="button button-small" href={`/${lang}/contact/`}>{t.cta}</a>
      </div>
    </div>
  </header>
  <slot />
  <script is:inline>
    (() => {
      const body = document.body;
      window.dataLayer = window.dataLayer || [];
      if (body?.dataset.pageType === "product") {
        window.dataLayer.push({ event: "product_view", product_name: body.dataset.productName || "" });
      }
      document.addEventListener("click", (event) => {
        const target = event.target;
        if (!(target instanceof Element)) return;
        const link = target.closest("a[href^='mailto:'], a[href^='tel:'], a[href*='wa.me']");
        if (link) window.dataLayer.push({ event: "contact_click", contact_method: link.href.startsWith("mailto:") ? "email" : link.href.startsWith("tel:") ? "phone" : "whatsapp" });
      });
    })();
  </script>
  <footer class="footer">
    <div class="container footer-grid">
      <div><a class="brand brand-footer" href={`/${lang}/`}><span class="brand-mark">S<span>.</span></span><span><strong>Sheerherb</strong><small>{t.tagline}</small></span></a><p class="footer-note">{t.footerNote}</p></div>
      <div class="footer-links">{t.nav.map(([slug, label]) => <a href={`/${lang}/${slug}/`}>{label}</a>)}<a href={`/${lang}/privacy/`}>{lang === "zh" ? "隐私政策" : "Privacy"}</a><a href={`/${lang}/terms/`}>{lang === "zh" ? "法律声明" : "Terms"}</a></div>
    </div>
    <div class="container footer-bottom"><span>© {new Date().getFullYear()} Sheerherb. All rights reserved.</span><span><a href="mailto:sales@sheerherb.com">sales@sheerherb.com</a></span></div>
  </footer>
</body>
</html>
