
---
import { site } from "../data/site";

interface Props {
  lang: "zh" | "en";
  title: string;
  description?: string;
}

const { lang, title, description = "" } = Astro.props;
const current = site[lang];
---

<!doctype html>
<html lang={lang === "zh" ? "zh-CN" : "en"}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{title} | {current.name}</title>
  </head>

  <body>
    <header class="header">
      <a class="logo" href={`/${lang}/`}>
        {current.name}
      </a>

      <nav>
        {current.nav.map((item) => (
          <a href={item.href}>{item.label}</a>
        ))}
      </nav>

      <div class="header-actions">
        <a class="language" href={current.languageUrl}>
          {current.languageLabel}
        </a>

        <a class="inquiry" href={`/${lang}/contact/`}>
          {current.inquiry}
        </a>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="footer">
      <p>{current.footer}</p>
      <a href={`/${lang}/privacy/`}>
        {lang === "zh" ? "隐私政策" : "Privacy Policy"}
      </a>
    </footer>
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(body) {
    margin: 0;
    font-family: Arial, "Microsoft YaHei", sans-serif;
    color: #1f2937;
    background: #fff;
  }

  .header {
    min-height: 76px;
    padding: 16px 5%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    border-bottom: 1px solid #e5e7eb;
  }

  .logo {
    color: #111827;
    font-size: 22px;
    font-weight: 800;
    text-decoration: none;
    white-space: nowrap;
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 22px;
  }

  nav a, .language {
    color: #374151;
    text-decoration: none;
    font-size: 14px;
  }

  nav a:hover, .language:hover {
    color: #2563eb;
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 16px;
    white-space: nowrap;
  }

  .inquiry {
    background: #2563eb;
    color: white;
    padding: 11px 18px;
    border-radius: 5px;
    text-decoration: none;
    font-size: 14px;
  }

  .footer {
    padding: 35px 5%;
    margin-top: 60px;
    background: #111827;
    color: #d1d5db;
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 15px;
  }

  .footer a {
    color: white;
  }

  @media (max-width: 900px) {
    .header {
      flex-wrap: wrap;
    }

    nav {
      order: 3;
      width: 100%;
      justify-content: flex-start;
    }
  }

  @media (max-width: 600px) {
    nav {
      gap: 14px;
    }

    nav a {
      font-size: 12px;
    }
  }
</style>
