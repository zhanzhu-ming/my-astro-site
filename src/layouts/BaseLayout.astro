---
import "../styles/global.css";
import { site } from "../data/site";
const { lang = "en", title, description } = Astro.props;
const t = site[lang];
const other = lang === "zh" ? "en" : "zh";
const path = Astro.url.pathname.replace(/^\/(zh|en)/, "") || "/";
const switchPath = `/${other}${path}`;
const pageTitle = `${title ? `${title} | ` : ""}${t.brand}`;
const desc = description || t.tagline;
---
<!doctype html>
<html lang={lang === "zh" ? "zh-CN" : "en"}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content={desc} />
  <meta name="theme-color" content="#102b3a" />
  <title>{pageTitle}</title>
  <link rel="canonical" href={`https://example.com${Astro.url.pathname}`} />
  <link rel="alternate" hreflang="zh-CN" href={`https://example.com/zh${path}`} />
  <link rel="alternate" hreflang="en" href={`https://example.com/en${path}`} />
  <link rel="alternate" hreflang="x-default" href={`https://example.com/en${path}`} />
</head>
<body>
  <div class="topline"><div class="container top-inner"><span>{t.trustLine}</span><a href={`/${lang}/contact/`}>{lang === "zh" ? "商务联系" : "Business Contact"} ↗</a></div></div>
  <header class="site-header">
    <div class="container nav-wrap">
      <a class="brand" href={`/${lang}/`} aria-label={t.brand}>
        <span class="brand-mark">C<span>.</span></span>
        <span><strong>{t.brand}</strong><small>{t.tagline}</small></span>
      </a>
      <nav class="desktop-nav" aria-label="Main navigation">
        {t.nav.map(([slug, label]) => <a href={`/${lang}/${slug}/`}>{label}</a>)}
      </nav>
      <div class="nav-actions">
        <a class="language" href={switchPath}>{other.toUpperCase()} ↗</a>
        <a class="button button-small" href={`/${lang}/contact/`}>{t.cta}</a>
      </div>
    </div>
  </header>
  <slot />
  <footer class="footer">
    <div class="container footer-grid">
      <div><a class="brand brand-footer" href={`/${lang}/`}><span class="brand-mark">C<span>.</span></span><span><strong>{t.brand}</strong><small>{t.tagline}</small></span></a><p class="footer-note">{t.footerNote}</p></div>
      <div class="footer-links">{t.nav.map(([slug, label]) => <a href={`/${lang}/${slug}/`}>{label}</a>)}</div>
    </div>
    <div class="container footer-bottom"><span>© {new Date().getFullYear()} {t.brand}. All rights reserved.</span><span><a href={`/${lang}/privacy/`}>{lang === "zh" ? "隐私政策" : "Privacy"}</a> · <a href={`/${lang}/terms/`}>{lang === "zh" ? "法律声明" : "Terms"}</a></span></div>
  </footer>
</body>
</html>
