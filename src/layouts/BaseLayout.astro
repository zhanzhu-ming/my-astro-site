---
import "../styles/global.css";
import { site } from "../data/site";
const { lang = "en", title, description } = Astro.props;
const t = site[lang];
const languages = [
  ["zh", "中文"], ["en", "English"], ["de", "Deutsch"],
  ["ja", "日本語"], ["es", "Español"], ["ru", "Русский"], ["it", "Italiano"]
];
const path = Astro.url.pathname.replace(/^\/(zh|en|de|ja|es|ru|it)(?=\/|$)/, "") || "/";
const languageName = languages.find(([code]) => code === lang)?.[1] || lang.toUpperCase();
const htmlLang = ({ zh: "zh-CN", en: "en", de: "de", ja: "ja", es: "es", ru: "ru", it: "it" })[lang] || "en";
const pageTitle = `${title ? `${title} | ` : ""}${t.brand}`;
const desc = description || t.tagline;
---
<!doctype html>
<html lang={htmlLang}>
<head>

  <!-- Google Tag Manager -->
  <script>
    (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
    new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
    j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
    'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
    })(window,document,'script','dataLayer','GTM-ND9Z73J6');
  </script>
  <!-- End Google Tag Manager -->
<meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content={desc} />
  <meta name="theme-color" content="#102b3a" />
  <title>{pageTitle}</title>
  <link rel="canonical" href={`https://sheerherb.cn${Astro.url.pathname}`} />
  {languages.map(([code]) => <link rel="alternate" hreflang={code === "zh" ? "zh-CN" : code} href={`https://sheerherb.cn/${code}${path}`} />)}
  <link rel="alternate" hreflang="x-default" href={`https://sheerherb.cn/en${path}`} />
</head>
<body>
  <div class="topline"><div class="container top-inner"><span>{t.trustLine}</span><a href={`/${lang}/contact/`}>{lang === "zh" ? "商务联系" : "Business Contact"} ↗</a></div></div>
  <header class="site-header">
    <div class="container nav-wrap">
      <a class="brand" href={`/${lang}/`} aria-label={t.brand}>
        <span class="brand-mark">C<span>.</span></span>
        <span><strong>{t.brand}</strong><small>{t.tagline}</small></span>
      </a>
      <nav class="desktop-nav" aria-label="Main navigation">
        {t.nav.map(([slug, label]) => <a href={`/${lang}/${slug}/`}>{label}</a>)}
      </nav>
      <div class="nav-actions">
        <details class="language-menu">
          <summary aria-label="Select language">{languageName} ▾</summary>
          <ul class="language-options">
            {languages.map(([code, label]) => <li><a href={`/${code}${path}`} aria-current={code === lang ? "page" : undefined}>{label}{code === lang ? " ✓" : ""}</a></li>)}
          </ul>
        </details>
        <a class="button button-small" href={`/${lang}/contact/`}>{t.cta}</a>
      </div>
    </div>
  </header>
  <slot />
  <footer class="footer">
    <div class="container footer-grid">
      <div><a class="brand brand-footer" href={`/${lang}/`}><span class="brand-mark">C<span>.</span></span><span><strong>{t.brand}</strong><small>{t.tagline}</small></span></a><p class="footer-note">{t.footerNote}</p></div>
      <div class="footer-links">{t.nav.map(([slug, label]) => <a href={`/${lang}/${slug}/`}>{label}</a>)}</div>
    </div>
    <div class="container footer-bottom"><span>© {new Date().getFullYear()} {t.brand}. All rights reserved.</span><span><a href={`/${lang}/privacy/`}>{lang === "zh" ? "隐私政策" : "Privacy"}</a> · <a href={`/${lang}/terms/`}>{lang === "zh" ? "法律声明" : "Terms"}</a></span></div>
  </footer>
</body>
</html>
