---
import "../styles/global.css";
import { site } from "../data/site";
import { getBrandCopy, languages, type Lang } from "../data/brand";

const {
  lang = "zh" as Lang,
  title,
  description,
  canonicalPath,
  noindex = false,
  breadcrumbs = [],
  pageType = "website",
  productName = "",
  productSlug = "",
  alternateLanguages = languages,
  article = null,
  faq = [],
} = Astro.props as {
  lang?: Lang;
  title?: string;
  description?: string;
  canonicalPath?: string;
  noindex?: boolean;
  breadcrumbs?: { name: string; url: string }[];
  pageType?: string;
  productName?: string;
  productSlug?: string;
  alternateLanguages?: readonly Lang[];
  article?: { headline: string; datePublished: string; dateModified: string; section?: string } | null;
  faq?: { q: string; a: string }[];
};

const t = site[lang] || site.zh;
const copy = getBrandCopy(lang);
const languageLabels: Record<string, string> = {
  zh: "中文",
  en: "English",
};
const pathRaw = Astro.url.pathname.replace(/^\/(zh|en)(?=\/|$)/, "") || "/";
const path = pathRaw.endsWith("/") ? pathRaw : `${pathRaw}/`;
const languageName = languageLabels[lang] || lang.toUpperCase();
const htmlLang = ({ zh: "zh-CN", en: "en" })[lang] || "zh-CN";
const canonicalUrlPath = canonicalPath || (Astro.url.pathname.endsWith("/") ? Astro.url.pathname : `${Astro.url.pathname}/`);
const canonical = `https://sheerherb.cn${canonicalUrlPath}`;
const pageTitle = title ? (title.includes("Sheerherb") ? title : `${title} | Sheerherb`) : "Sheerherb";
const desc = description || copy.heroLead;
const availableLanguages = languages.filter((code) => alternateLanguages.includes(code));
const defaultLanguage = availableLanguages.includes("zh") ? "zh" : availableLanguages[0] || "zh";
const emitAlternates = !canonicalUrlPath.endsWith(".html");
const alternateUrls = availableLanguages.map((code) => ({
  code,
  href: `https://sheerherb.cn/${code}${path === "/" ? "/" : path}`,
}));

const organizationId = "https://sheerherb.cn/#organization";
const websiteId = "https://sheerherb.cn/#website";
const structuredData: Record<string, unknown>[] = [
  {
    "@type": "Organization",
    "@id": organizationId,
    name: "Sheerherb",
    legalName: "Xi'an Sheerherb Biological Technology Co., Ltd.",
    url: "https://sheerherb.cn/zh/",
    logo: "https://sheerherb.cn/favicon.svg",
    email: "sales@sheerherb.com",
    telephone: "+86-19591570368",
    address: {
      "@type": "PostalAddress",
      streetAddress: "雁塔区万科汇智中心 1204 室",
      addressLocality: "西安市",
      addressRegion: "陕西省",
      addressCountry: "CN",
    },
    contactPoint: [
      {
        "@type": "ContactPoint",
        contactType: "sales",
        email: "sales@sheerherb.com",
        telephone: "+86-19591570368",
        availableLanguage: ["zh-CN", "en"],
      },
    ],
  },
  {
    "@type": "WebSite",
    "@id": websiteId,
    url: "https://sheerherb.cn/zh/",
    name: "Sheerherb",
    alternateName: "Sheerherb 植物提取物与功能性原料",
    publisher: { "@id": organizationId },
    inLanguage: htmlLang,
  },
];

if (breadcrumbs.length) {
  structuredData.push({
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: lang === "zh" ? "首页" : "Home", item: `https://sheerherb.cn/${lang}/` },
      ...breadcrumbs.map((item, index) => ({
        "@type": "ListItem",
        position: index + 2,
        name: item.name,
        item: item.url,
      })),
    ],
  });
}

if (article) {
  structuredData.push({
    "@type": "Article",
    headline: article.headline,
    description: desc,
    datePublished: article.datePublished,
    dateModified: article.dateModified,
    inLanguage: htmlLang,
    mainEntityOfPage: canonical,
    articleSection: article.section || undefined,
    author: { "@id": organizationId },
    publisher: { "@id": organizationId },
  });
}

if (faq.length) {
  structuredData.push({
    "@type": "FAQPage",
    mainEntity: faq.map((item) => ({
      "@type": "Question",
      name: item.q,
      acceptedAnswer: { "@type": "Answer", text: item.a },
    })),
  });
}

const jsonLd = JSON.stringify({ "@context": "https://schema.org", "@graph": structuredData }).replace(/</g, "\\u003c");
---
<!doctype html>
<html lang={htmlLang}>
<head>
  <!-- Google Tag Manager -->
  <script>
    (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
    new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
    j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
    'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
    })(window,document,'script','dataLayer','GTM-ND9Z73J6');
  </script>
  <!-- End Google Tag Manager -->
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content={desc} />
  <meta name="theme-color" content="#102b3a" />
  <meta name="robots" content={noindex ? "noindex,follow" : "index,follow,max-image-preview:large"} />
  <meta name="twitter:card" content="summary" />
  <meta property="og:type" content={article ? "article" : pageType === "product" ? "product" : "website"} />
  <meta property="og:site_name" content="Sheerherb" />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={desc} />
  <meta property="og:url" content={canonical} />
  <meta property="og:locale" content={htmlLang} />
  {article && <meta property="article:published_time" content={article.datePublished} />}
  {article && <meta property="article:modified_time" content={article.dateModified} />}
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <title>{pageTitle}</title>
  <link rel="canonical" href={canonical} />
  {emitAlternates && alternateUrls.map((item) => <link rel="alternate" hreflang={item.code === "zh" ? "zh-CN" : item.code} href={item.href} />)}
  {emitAlternates && <link rel="alternate" hreflang="x-default" href={`https://sheerherb.cn/${defaultLanguage}${path === "/" ? "/" : path}`} />}
  <script type="application/ld+json" set:html={jsonLd}></script>
</head>
<body data-page-type={pageType} data-product-name={productName} data-product-slug={productSlug}>
  <!-- Google Tag Manager (noscript) -->
  <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-ND9Z73J6"
  height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
  <!-- End Google Tag Manager (noscript) -->
  <div class="topline"><div class="container top-inner"><span>{t.tagline}</span><a href={`/${lang}/contact/`}>{lang === "zh" ? "商务联系" : "Business Contact"} ↗</a></div></div>
  <header class="site-header">
    <div class="container nav-wrap">
      <a class="brand" href={`/${lang}/`} aria-label="Sheerherb">
        <span class="brand-mark">S<span>.</span></span>
        <span><strong>Sheerherb</strong><small>{t.tagline}</small></span>
      </a>
      <nav class="desktop-nav" aria-label="Main navigation">
        {t.nav.map(([slug, label]) => <a href={`/${lang}/${slug}/`}>{label}</a>)}
      </nav>
      <div class="nav-actions">
        {availableLanguages.length > 1 ? (
          <details class="language-menu">
            <summary aria-label="Select language">{languageName} ▾</summary>
            <ul class="language-options">
              {availableLanguages.map((code) => <li><a href={`/${code}${path}`} aria-current={code === lang ? "page" : undefined}>{languageLabels[code]}{code === lang ? " ✓" : ""}</a></li>)}
            </ul>
          </details>
        ) : (
          <span class="language-current">{languageName}</span>
        )}
        <a class="button button-small" href={`/${lang}/contact/`}>{t.cta}</a>
      </div>
    </div>
  </header>
  <slot />
  <script is:inline>
    (() => {
      const body = document.body;
      window.dataLayer = window.dataLayer || [];
      if (body?.dataset.pageType === "product") {
        window.dataLayer.push({
          event: "product_view",
          product_name: body.dataset.productName || "",
          product_slug: body.dataset.productSlug || ""
        });
      }
      document.addEventListener("click", (event) => {
        const target = event.target;
        if (!(target instanceof Element)) return;
        const link = target.closest("a[href^='mailto:'], a[href^='tel:'], a[href*='wa.me']");
        if (link) window.dataLayer.push({ event: "contact_click", contact_method: link.href.startsWith("mailto:") ? "email" : link.href.startsWith("tel:") ? "phone" : "whatsapp" });
      });
    })();
  </script>
  <footer class="footer">
    <div class="container footer-grid">
      <div><a class="brand brand-footer" href={`/${lang}/`}><span class="brand-mark">S<span>.</span></span><span><strong>Sheerherb</strong><small>{t.tagline}</small></span></a><p class="footer-note">{t.footerNote}</p></div>
      <div class="footer-links">{t.nav.map(([slug, label]) => <a href={`/${lang}/${slug}/`}>{label}</a>)}<a href={`/${lang}/privacy/`}>{lang === "zh" ? "隐私政策" : "Privacy"}</a><a href={`/${lang}/terms/`}>{lang === "zh" ? "法律声明" : "Terms"}</a></div>
    </div>
    <div class="container footer-bottom"><span>© {new Date().getFullYear()} Sheerherb. All rights reserved.</span><span><a href="mailto:sales@sheerherb.com">sales@sheerherb.com</a></span></div>
  </footer>
</body>
</html>
